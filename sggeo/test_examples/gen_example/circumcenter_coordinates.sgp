sgp 2

given
  point A
    x_A: x(A) = 4
    y_A: y(A) = 0
  point B
    x_B: x(B) = 1
    y_B: y(B) = 3

construct
  C = mid(O, A)
  l1 = perp(OA, C)
  D = mid(A, B)
  l2 = perp(AB, D)
  E = meet(l1, l2)

find
  x_E: x(E)
  y_E: y(E)

where
  A (4, -4.239575861902385e-168)
  B (1, 3)
  C (2, -2.1197879309511924e-168)
  D (2.5, 1.5)
  E (2, 1)
  x_A label (0.3, 0.3)
  y_A label (0.3, 0.3)
  x_B label (0.3, 0.3)
  y_B label (0.3, 0.3)
  x_E label (0.3, 0.3)
  y_E label (0.3, 0.3)

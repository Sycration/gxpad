sgp 2

given
  g1 = curve(y = sin(x))
  k1 = circle(O)

construct
  A = meet(g1, xaxis)
    A on k1
  point B on k1
  point C on g1
    horiz B C
  segment BC
    BC tan g1

find
  d1: |BC|

where
  k1 r 3.141592653589793
  A (-3.141592653589793, -9.797487745742066e-31)
  B (-2.9781881070693568, 1)
  C (1.5707963267948966, 1)
  d1 label (0.3, 0.3)

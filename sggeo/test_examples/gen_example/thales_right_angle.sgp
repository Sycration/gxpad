sgp 2

given
  k1 = circle(O)
    r1: r(k1) = 2

construct
  point A on k1
  point B on k1
  point C on k1
  segment AB
    O on AB
  segment CA
  segment CB

find
  θ1: ∠ACB

where
  k1 r 2
  A (-2, 0)
  B (2, 0)
  C (0.7248925223098966, 1.864009343082592)
  r1 label (0.3, 0.3)
  θ1 label (0.3, 0.3)

sgp 2

given
  point A
    x_A: x(A) = 0
    y_A: y(A) = 0
  point B
    x_B: x(B) = 5
    y_B: y(B) = 1
  e1 = ellipse(A)
    a1: a(e1) = 2
    b1: b(e1) = 1
  k1 = circle(B)
    r1: r(k1) = 0.8

construct
  point C on e1
  point D on k1
  segment CD
    CD tan e1
    CD tan k1

find
  x_C: x(C)

where
  A (-4.190823558986625e-31, -3.3280069439011436e-31)
  B (5, 1)
  e1 a 2 b 1 angle 0° [fixed angle]
  k1 r 0.8
  C (-0.5842789613209505, 0.9563757231545706)
  D (4.879214602565404, 1.790829240586466)
  x_A label (0.3, 0.3)
  y_A label (0.3, 0.3)
  x_B label (0.3, 0.3)
  y_B label (0.3, 0.3)
  a1 label (0.3, 0.3)
  b1 label (0.3, 0.3)
  r1 label (0.3, 0.3)
  x_C label (0.3, 0.3)

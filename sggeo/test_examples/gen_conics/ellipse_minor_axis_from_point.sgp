sgp 2

given
  point A
  e1 = ellipse(A)
    a1: a(e1) = 5

construct
  point B on e1
    d1: dx(A, B) = 3
    d2: dy(A, B) = 2.4

find
  b1: b(e1)

where
  A (1, 0.9500000000000002)
  e1 a 5 b 2.9999999999999996 angle 0° [fixed angle]
  B (4, 3.3499999999999996)
  a1 label (0.3, 0.3)
  d1 label (0.3, 0.3)
  d2 label (0.3, 0.3)
  b1 label (0.3, 0.3)

sgp 2

given
  e1 = ellipse(O)
    a1: a(e1) = 3
    b1: b(e1) = 2
  point A
    x_A: x(A) = -1
    y_A: y(A) = 0.5
  p1 = parabola(A)
    a2: a(p1) = 1

construct
  B = meet(e1, p1)

find
  y_B: y(B)

where
  e1 a 3 b 2 angle 0° [fixed angle]
  A (-1, 0.5)
  p1 a 1 angle 0° [fixed angle]
  B (-0.454695644294263, 1.976894519870308)
  a1 label (0.3, 0.3)
  b1 label (0.3, 0.3)
  x_A label (0.3, 0.3)

sgp 2

given
  a = 5
  b = 3
  e1 = ellipse(O)
    a1: a(e1) = a
    b1: b(e1) = b
  point B

construct
  A = focus(e1)
    O == mid(A, B)
  l1 = directrix(e1, A)
  point C on e1
    y_C: y(C) = 2

find
  d1: dist(C, A)
  d2: dist(C, l1)

where
  e1 a 5 b 3 angle 0° [fixed angle]
  B (-4, -9.402377751655386e-36)
  A (4, 9.392199863070077e-36)
  C (3.7267799624996494, 2)
  a1 label (0.3, 0.3)
  b1 label (0.3, 0.3)
  y_C label (0.3, 0.3)
  d1 label (0.3, 0.3)
  d2 label (0.3, 0.3)

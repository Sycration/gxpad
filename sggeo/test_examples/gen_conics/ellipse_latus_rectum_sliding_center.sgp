sgp 2

given
  a = 5
  b = 3
  point C

construct
  point A on xaxis
  e1 = ellipse(A)
    a1: a(e1) = a
    b1: b(e1) = b
  B = focus(e1)
    A == mid(B, C)
  l1 = perp(xaxis, B)
  D = meet(l1, e1)
  E = meet(l1, e1)

find
  d1: dist(D, E)

where
  C (-3, 9.95108931369775e-54)
  A (1, 9.95108931369775e-54)
  e1 a 5 b 3 angle 0° [fixed angle]
  B (5, 9.95108931369775e-54)
  D (5, 1.8)
  E (5, -1.8)
  a1 label (0.3, 0.3)
  b1 label (0.3, 0.3)
  d1 label (0.3, 0.3)

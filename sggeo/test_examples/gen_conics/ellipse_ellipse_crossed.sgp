sgp 2

given
  e1 = ellipse(O)
    a1: a(e1) = 5
    b1: b(e1) = 3
  e2 = ellipse(O)
    a2: a(e2) = 3
    b2: b(e2) = 5

construct
  A = meet(e1, e2)

find
  d1: dist(O, A)

where
  e1 a 5 b 3 angle 0° [fixed angle]
  e2 a 3 b 5 angle 0° [fixed angle]
  A (2.5724787771376323, 2.5724787771376327)
  a1 label (0.3, 0.3)
  b1 label (0.3, 0.3)
  a2 label (0.3, 0.3)

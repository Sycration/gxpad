sgp 2

given
  p1 = parabola(O)
    a1: a(p1) = 1.5

construct
  A = focus(p1)
  point B on p1
    y_B: y(B) = 3
  line BC
    BC tan p1
  D = meet(BC, xaxis)

find
  d1: dist(D, A)
  x_D: x(D)

where
  p1 a 1.5 angle 0° [fixed angle]
  A (1.5, 0)
  B (1.5, 3)
  C (0, 1.5)
  D (-1.5, 0)
  a1 label (0.3, 0.3)
  y_B label (0.3, 0.3)
  d1 label (0.3, 0.3)
  x_D label (0.3, 0.3)

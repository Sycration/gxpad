sgp 2

given
  h1 = hyperbola(O)
    a1: a(h1) = 3
    b1: b(h1) = 4
  point A
    x_A: x(A) = 3
    y_A: y(A) = 4.5

construct
  B = tangent(A, h1)
  segment AB

find
  y_B: y(B)

where
  h1 a 3 b 4 angle 0° [fixed angle]
  A (3, 4.5)
  B (3, 0)
  a1 label (0.3, 0.3)
  b1 label (0.3, 0.3)
  x_A label (0.3, 0.3)
  y_A label (0.3, 0.3)
  y_B label (0.3, 0.3)

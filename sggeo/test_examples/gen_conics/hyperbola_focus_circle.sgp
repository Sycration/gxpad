sgp 2

given
  a = 3
  b = 4
  point A
  h1 = hyperbola(A)
    a1: a(h1) = a
    b1: b(h1) = b
  point C

construct
  B = focus(h1)
    A == mid(B, C)
  k1 = circle(B)
    k1 tan h1 near (4.0125, 1)

find
  r1: r(k1)

where
  A (1.0125000000000002, 1)
  h1 a 3 b 4 angle 0° [fixed angle]
  C (-3.9875, 1)
  B (6.0125, 1)
  k1 r 2
  a1 label (0.3, 0.3)
  b1 label (0.3, 0.3)
  r1 label (0.3, 0.3)

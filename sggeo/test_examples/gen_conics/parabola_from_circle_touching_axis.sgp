sgp 2

given
  r = 1
  k1 = circle(O)
    r1: r(k1) = r
  line AB
    AB tan k1
  segment OC
    OC ⟂ AB
  point D
  p1 = parabola(D)
    C == focus(p1)
    AB == directrix(p1, C)
    p1 tan xaxis

construct
  E = meet(OC, k1)
  segment CE
    d1: |CE| = r
  F = meet(p1, xaxis)

find
  d2: dist(F, O)

where
  k1 r 1
  A (2.551416125350533, 2.4191823603576466)
  B (0.23070533397713985, -1.6004066399744463)
  C (1.7320508075688772, -1.0000000000000002)
  D (1.2990381056766578, -0.75)
  p1 a 0.5000000000000002 angle -30.00000000000001°
  E (0.8660254037844386, -0.5000000000000001)
  F (3.464101615137754, -9.693448847645929e-27)
  r1 label (0.3, 0.3)
  d1 label (0.3, 0.3)
  d2 label (0.3, 0.3)

sgp 2

given
  a = 3
  b = 4
  h1 = hyperbola(O)
    a1: a(h1) = a
    b1: b(h1) = b
  point B

construct
  A = focus(h1)
    O == mid(A, B)
  point C on h1
    d1: dist(A, C) = 4

find
  d2: dist(B, C)

where
  h1 a 3 b 4 angle 0° [fixed angle]
  B (-5, -8.155867677721219e-45)
  A (5, 6.094012454172142e-45)
  C (4.2, 3.919183588453085)
  a1 label (0.3, 0.3)
  b1 label (0.3, 0.3)
  d1 label (0.3, 0.3)
  d2 label (0.3, 0.3)

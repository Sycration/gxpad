sgp 2

given
  g1 = curve(y = x^2)
  point A
    x_A: x(A) = 3
    y_A: y(A) = 0
  k1 = circle(A)
    r1: r(k1) = 1

construct
  point B on g1
  point C on k1
  segment BC
    BC tan g1
    BC tan k1

find
  x_B: x(B)

where
  A (3, 3.0814879110195774e-33)
  k1 r 1
  B (0.18307332634813395, 0.03351584282017035)
  C (2.656175827510578, 0.9390340453955671)
  x_A label (0.3, 0.3)
  y_A label (0.3, 0.3)
  r1 label (0.3, 0.3)
  x_B label (0.3, 0.3)

sgp 2

given
  h1 = hyperbola(O)
    a1: a(h1) = 3
    b1: b(h1) = 4
  point B

construct
  A = focus(h1)
    O == mid(A, B)
  point C on h1
    y_C: y(C) = 4

find
  x_C: x(C)
  d1: dist(C, A)

where
  h1 a 3 b 4 angle 0° [fixed angle]
  B (-5, 0)
  A (5, 0)
  C (-4.242640687119286, 4)
  a1 label (0.3, 0.3)
  b1 label (0.3, 0.3)
  y_C label (0.3, 0.3)
  x_C label (0.3, 0.3)
  d1 label (0.3, 0.3)

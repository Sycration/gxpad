find
  x_C: x(C)

where
  p1 a 1 angle 0° [fixed angle]
  A (-3.697785493223493e-32, 1)
  B (2, 2)
  C (0.3431457505076198, 1.17157287525381)
  a1 label (0.3, 0.3)
  x_A label (0.3, 0.3)
  y_A label (0.3, 0.3)

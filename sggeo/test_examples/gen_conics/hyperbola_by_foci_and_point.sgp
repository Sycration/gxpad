sgp 2

given
  point A
    d1: dist(O, A) = 10
  point B
    d2: dist(B, O) = 9
    d3: dist(B, A) = 3

construct
  C = mid(O, A)
  h1 = hyperbola(C)
    O == focus(h1)
    B on h1
  l1 = asymptote(h1, 1)
  l2 = asymptote(h1, -1)

find
  a1: a(h1)
  b1: b(h1)
  θ1: angle(l1, l2)

where
  A (9.994203723640167, -0.34042903868064794)
  B (8.685341233454151, 2.3589929331096204)
  C (4.9971018618200835, -0.17021451934032397)
  h1 a 3 b 4 angle 178.04910834118294°
  d1 label (0.3, 0.3)
  d2 label (0.3, 0.3)
  d3 label (0.3, 0.3)
  a1 label (0.3, 0.3)
  b1 label (0.3, 0.3)
  θ1 label (-0.49971, 0.0170215)

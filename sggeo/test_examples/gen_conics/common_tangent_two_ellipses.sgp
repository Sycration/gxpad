sgp 2

given
  point A
    x_A: x(A) = 0
    y_A: y(A) = 0
  point B
    x_B: x(B) = 5
    y_B: y(B) = 1
  e1 = ellipse(A)
    a1: a(e1) = 2
    b1: b(e1) = 1
  e2 = ellipse(B)
    a2: a(e2) = 1.5
    b2: b(e2) = 0.8

construct
  point C on e1
  point D on e2
  segment CD
    CD tan e1
    CD tan e2

find
  x_C: x(C)

where
  A (-2.8696356171369814e-32, 1.0785207688568521e-32)
  B (5, 1)
  e1 a 2 b 1 angle 0° [fixed angle]
  e2 a 1.5 b 0.8 angle 0° [fixed angle]
  C (-0.5996960793170383, 0.9539869774336247)
  D (4.576024381828521, 1.7673783919946062)
  x_A label (0.3, 0.3)
  y_A label (0.3, 0.3)
  x_B label (0.3, 0.3)
  y_B label (0.3, 0.3)
  a1 label (0.3, 0.3)
  b1 label (0.3, 0.3)
  a2 label (0.3, 0.3)
  b2 label (0.3, 0.3)
  x_C label (0.3, 0.3)

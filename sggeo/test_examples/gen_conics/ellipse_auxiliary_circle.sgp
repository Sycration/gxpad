sgp 2

given
  a = 5
  point A
  e1 = ellipse(A)
    a1: a(e1) = a
    b1: b(e1) = 3
  k1 = circle(A)
    r1: r(k1) = a

construct
  point B on e1
    d1: dx(A, B) = 3
  point C on k1
    vert B C
  segment BC

find
  d2: dy(A, B)
  d3: dy(A, C)

where
  A (0.5, 0.5333333333333335)
  e1 a 5 b 3 angle 0° [fixed angle]
  k1 r 5
  B (3.5, 2.9333333333333336)
  C (3.5, 4.533333333333333)
  a1 label (0.3, 0.3)
  b1 label (0.3, 0.3)
  r1 label (0.3, 0.3)
  d1 label (0.3, 0.3)
  d2 label (0.3, 0.3)
  d3 label (0.3, 0.3)

sgp 2

given
  e1 = ellipse(O)
    a1: a(e1) = 5
    b1: b(e1) = 3
  point B
  line CD
    horiz C D
    y_C: y(C) = 1
    x_C: x(C) = -6

construct
  A = focus(e1)
    O == mid(A, B)
  segment OA
    θ1: angle(xaxis, OA) = 30°
  E = meet(CD, e1)

find
  x_E: x(E)

where
  e1 a 5 b 3 angle 30°
  B (-3.464101615137755, -1.9999999999999998)
  C (-6, 1)
  D (6, 1)
  A (3.464101615137755, 1.9999999999999998)

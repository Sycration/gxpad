sgp 2

given
  a = 1.5
  point A
  p1 = parabola(A)
    a1: a(p1) = a

construct
  B = focus(p1)
  k1 = circle(B)
    k1 tan p1 near (0.016666666666666687, 2.8575091980104915e-17)

find
  r1: r(k1)

where
  A (0.016666666666666687, 2.8575091980104915e-17)
  p1 a 1.5 angle 0° [fixed angle]
  B (1.5166666666666666, 2.8575091980104915e-17)
  k1 r 1.5
  a1 label (0.3, 0.3)
  r1 label (0.3, 0.3)

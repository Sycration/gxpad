sgp 2

given
  p1 = parabola(O)
    a1: a(p1) = 1.5

construct
  A = focus(p1)
  line AB
    θ1: angle(xaxis, AB) = 70°
  C = meet(AB, p1)
  D = meet(AB, p1)

find
  d1: dist(C, D)

where
  p1 a 1.5 angle 0° [fixed angle]
  A (1.5, 0)
  B (1.8420201433256689, 0.9396926207859083)
  C (3.059410093742213, 4.284444020226344)
  D (0.7354358948485535, -2.10062261462913)
  a1 label (0.3, 0.3)
  θ1 label (0.3, 0.3)
  d1 label (0.3, 0.3)

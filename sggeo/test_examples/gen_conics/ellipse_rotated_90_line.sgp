sgp 2

given
  e1 = ellipse(O)
    a1: a(e1) = 5
    b1: b(e1) = 3
  point B
  line CD
    horiz C D
    y_C: y(C) = 2
    x_C: x(C) = -6

construct
  A = focus(e1)
    O == mid(A, B)
  segment OA
    θ1: angle(xaxis, OA) = 90°
  E = meet(CD, e1)

find
  x_E: x(E)

where
  e1 a 5 b 3 angle 90°
  B (-2.4492935982947064e-16, -4)
  C (-6, 2)
  D (6, 2)
  A (2.4492935982947064e-16, 4)
  E (2.749545416973504, 2)
  a1 label (0.3, 0.3)
  b1 label (0.3, 0.3)
  y_C label (0.3, 0.3)
  x_C label (0.3, 0.3)
  θ1 label (0.365844, 0.340819)
  x_E label (0.3, 0.3)

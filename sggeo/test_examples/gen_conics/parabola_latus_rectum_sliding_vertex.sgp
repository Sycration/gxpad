sgp 2

given
  a = 2

construct
  point A on xaxis
  p1 = parabola(A)
    a1: a(p1) = a
  B = focus(p1)
  l1 = perp(xaxis, B)
  C = meet(l1, p1)
  D = meet(l1, p1)

find
  d1: dist(C, D)

where
  A (1, 0)
  p1 a 2 angle 0° [fixed angle]
  B (3, 0)
  C (3, 4)
  D (3, -4)
  a1 label (0.3, 0.3)
  d1 label (0.3, 0.3)

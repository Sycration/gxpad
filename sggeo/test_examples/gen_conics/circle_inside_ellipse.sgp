sgp 2

given
  e1 = ellipse(O)
    a1: a(e1) = 5
    b1: b(e1) = 3

construct
  point A on xaxis
    x_A: x(A) = 1.5
  k1 = circle(A)
    k1 tan e1 near (2.34375, -2.6499926297067318)

find
  r1: r(k1)

where
  e1 a 5 b 3 angle 0° [fixed angle]
  A (1.5, 9.755344846421832e-26)
  k1 r 2.7810744326608736
  a1 label (0.3, 0.3)
  b1 label (0.3, 0.3)
  x_A label (0.3, 0.3)
  r1 label (0.3, 0.3)

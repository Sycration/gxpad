sgp 2

given
  point A
    x_A: x(A) = 1
    y_A: y(A) = 1
  line BC
    horiz B C
    d1: dy(B, A) = 4
    x_B: x(B) = -1
  point D
  p1 = parabola(D)
    A == focus(p1)
    BC == directrix(p1, A)
  k1 = circle(A)
    r1: r(k1) = 5

construct
  E = meet(p1, k1)

find
  d2: dy(B, E)

where
  A (1, 1)
  B (-1, -3)
  C (1.0000000000001585, -3)
  D (1, -0.9999999999999999)
  p1 a 2 angle 90°
  k1 r 5
  E (5.898979485566357, 2.0000000000000004)
  x_A label (0.3, 0.3)
  y_A label (0.3, 0.3)
  d1 label (0.3, 0.3)
  x_B label (0.3, 0.3)
  r1 label (0.3, 0.3)
  d2 label (0.3, 0.3)

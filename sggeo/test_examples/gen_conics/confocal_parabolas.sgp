sgp 2

given
  a = 1
  b = 2
  point A
    x_A: x(A) = -a
    y_A: y(A) = 0
  point B
    x_B: x(B) = b
    y_B: y(B) = 0
  p1 = parabola(A)
    a1: a(p1) = a
  p2 = parabola(B)
    a2: a(p2) = b

construct
  C = meet(p1, p2)

find
  d1: dist(O, C)
  x_C: x(C)
  y_C: y(C)

where
  A (-1, 8.375397249608798e-38)
  B (2, 6.902532920683853e-31)
  p1 a 1 angle 0° [fixed angle]
  p2 a 2 angle 180° [fixed angle]
  C (1.0000000000000002, 2.8284271247461903)
  x_A label (0.3, 0.3)
  y_A label (0.3, 0.3)
  x_B label (0.3, 0.3)
  y_B label (0.3, 0.3)
  a1 label (0.3, 0.3)
  a2 label (0.3, 0.3)
  d1 label (0.3, 0.3)
  x_C label (0.3, 0.3)
  y_C label (0.3, 0.3)

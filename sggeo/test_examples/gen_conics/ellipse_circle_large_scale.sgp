sgp 2

given
  e1 = ellipse(O)
    a1: a(e1) = 5
    b1: b(e1) = 3
  k1 = circle(O)
    r1: r(k1) = 4

construct
  A = meet(e1, k1)

find
  y_A: y(A)

where
  e1 a 5 b 3 angle 0° [fixed angle]
  k1 r 4
  A (3.307189138830738, 2.25)
  a1 label (0.3, 0.3)
  b1 label (0.3, 0.3)
  r1 label (0.3, 0.3)
  y_A label (0.3, 0.3)

sgp 2

given
  h = 2
  segment AB
    d1: |AB| = 6
  segment CA
  segment CB
    |CA| == |CB|

construct
  D = mid(A, B)
    d2: dist(C, D) = h

find
  d3: |CA|
  θ1: ∠ACB

where
  A (-2.919136835666529, 0.6099547281356679)
  B (3.0791164374525826, 0.4651870814881257)
  C (0.12824568310887421, 2.5369886625182674)
  D (0.07998980089302686, 0.5375709048118967)
  d1 label (0.3, 0.3)
  d2 label (0.3, 0.3)
  d3 label (0.3, 0.3)
  θ1 label (0.3, 0.3)

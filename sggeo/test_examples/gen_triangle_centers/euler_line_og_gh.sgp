sgp 2

given
  triangle BCA
    d1: |BC| = 14
    d2: |CA| = 15
    d3: |AB| = 13

construct
  D = mid(B, C)
  l1 = perp(BC, D)
  E = mid(C, A)
  l2 = perp(CA, E)
  F = meet(l1, l2)
  G = mid(B, C)
  H = mid(C, A)
  segment AG
  segment BH
  I = meet(AG, BH)
  l3 = perp(BC, A)
  l4 = perp(CA, B)
  J = meet(l3, l4)

find
  d4: dist(F, I)
  d5: dist(I, J)
  d6: dist(F, J)


sgp 2

given
  s = 9
  l1 = segment AB
  segment BC
    len(l1) == |BC|
    d1: |BC| = s
  segment CA
    |BC| == |CA|
  point D
  k1 = circle(D)
    A on k1
    B on k1
    C on k1
  k2 = circle(D)
  l2 = line AB
    l2 tan k2

find
  r1: r(k1)
  r2: r(k2)

where
  A (0.05382606071295173, 6.2961120126614425)
  B (-4.476878034230774, -1.480308783827142)
  C (4.523051973517822, -1.5158032288343)
  D (0.03333333333333365, 1.1000000000000005)
  k1 r 5.196152422706632
  k2 r 2.5980762113533165
  d1 label (0.3, 0.3)
  r1 label (0.3, 0.3)
  r2 label (0.3, 0.3)

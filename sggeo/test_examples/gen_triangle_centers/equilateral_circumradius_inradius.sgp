sgp 2

given
  s = 9
  l1 = segment AB
  segment BC
    len(l1) == |BC|
    d1: |BC| = s
  segment CA
    |BC| == |CA|
  point D
  k1 = circle(D)
    A on k1
    B on k1
    C on k1
  k2 = circle(D)
  l2 = line AB
    l2 tan k2

find
  r1: r(k1)
  r2: r(k2)

where
  A (0.053826060712948993, 6.2961120126614425)
  B (-4.476878034230773, -1.4803087838271447)
  C (4.523051973517823, -1.5158032288342969)
  D (0.03333333333333328, 1.1)
  k1 r 5.196152422706632
  k2 r 2.598076211353317
  d1 label (0.3, 0.3)
  r1 label (0.3, 0.3)
  r2 label (0.3, 0.3)

sgp 2

given
  triangle BCA
    d1: |BC| = 14
    d2: |CA| = 15
    d3: |AB| = 13

construct
  D = mid(B, C)
  l1 = line AD
  point E on l1
  segment DE
  l2 = segment AD
    |DE| == len(l2)

find
  d4: dist(A, E)
  d5: dist(B, E)

where
  B (0.011249526429245437, -0.009556246118601336)
  C (14.010489954681551, -0.1553898224520603)
  A (5.135978459090892, 11.937709272264282)
  D (7.010869740555399, -0.08247303428533082)
  E (8.885761022019905, -12.102655340834943)
  d1 label (0.3, 0.3)
  d2 label (0.3, 0.3)
  d3 label (0.3, 0.3)
  d4 label (0.3, 0.3)
  d5 label (0.3, 0.3)

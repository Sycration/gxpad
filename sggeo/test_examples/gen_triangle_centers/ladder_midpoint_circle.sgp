sgp 2

construct
  point A on xaxis
  point B on yaxis
  segment AB
    d1: |AB| = 5
  C = mid(AB)
  k1 = circle(C)
    O on k1

find
  d2: dist(O, C)
  r1: r(k1)

where
  A (4, 2.3317667240463116e-167)
  B (3.2326765947005684e-167, 3)
  C (2, 1.5)
  k1 r 2.5
  d1 label (0.3, 0.3)
  d2 label (0.3, 0.3)
  r1 label (0.3, 0.3)

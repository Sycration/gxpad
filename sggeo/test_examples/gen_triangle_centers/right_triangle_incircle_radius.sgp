sgp 2

given
  line AB
    d1: |AB| = 4
  line AC
    AB ⟂ AC
    d2: |AC| = 3
  line BC
  point D
  k1 = circle(D)
    AB tan k1
    AC tan k1
    BC tan k1

find
  r1: r(k1)

where
  A (0.07304048399526578, -0.003139263954756546)
  B (4.072008146763148, 0.08773225048615983)
  C (0.004886848164578488, 2.9960864831211547)
  D (1.0500645210770072, 1.019320530347443)
  k1 r 1.0000000000000002
  d1 label (0.3, 0.3)
  d2 label (0.3, 0.3)
  r1 label (0.3, 0.3)

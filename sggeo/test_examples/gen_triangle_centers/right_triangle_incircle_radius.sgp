sgp 2

given
  line AB
    d1: |AB| = 4
  line AC
    AB ⟂ AC
    d2: |AC| = 3
  line BC
  point D
  k1 = circle(D)
    AB tan k1
    AC tan k1
    BC tan k1

find
  r1: r(k1)

where
  A (0.0730404839952664, -0.003139263954757127)
  B (4.072008146763148, 0.08773225048616067)
  C (0.004886848164578062, 2.996086483121154)
  D (1.0500645210770077, 1.0193205303474429)
  k1 r 1.0000000000000002
  d1 label (0.3, 0.3)
  d2 label (0.3, 0.3)
  r1 label (0.3, 0.3)

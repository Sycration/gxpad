sgp 2

given
  line AB
    d1: dist(A, B) = 14
  line BC
  line CA
  point D
  k1 = circle(D)
    AB tan k1
    BC tan k1
    CA tan k1
    r1: r(k1) = 4
  point E
  k2 = circle(E)
    C on k2
    A on k2
    B on k2
    r2: r(k2) = 8.125

find
  d2: dist(B, C)

where
  A (0.05163807222186919, -0.033829586408042234)
  B (14.051601971214229, -0.0020360821866571605)

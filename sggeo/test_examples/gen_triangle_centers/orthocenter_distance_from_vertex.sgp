sgp 2

given
  triangle BCA
    d1: |BC| = 14
    d2: |CA| = 15
    d3: |AB| = 13

construct
  l1 = perp(BC, A)
  l2 = perp(CA, B)
  D = meet(l1, l2)

find
  d4: dist(A, D)
  d5: dist(B, D)

where
  B (-0.048022375150293346, 0.04567303886092185)
  C (13.949310108803786, -0.22760947730855607)
  A (5.185267097264287, 11.94578569790389)
  D (5.0242256145215585, 3.697357627002379)
  d1 label (0.3, 0.3)
  d2 label (0.3, 0.3)
  d3 label (0.3, 0.3)
  d4 label (0.3, 0.3)
  d5 label (0.3, 0.3)

sgp 2

given
  triangle BCA
    d1: |BC| = 14
    d2: |CA| = 15
    d3: |AB| = 13

construct
  l1 = perp(BC, A)
  l2 = perp(CA, B)
  D = meet(l1, l2)

find
  d4: dist(A, D)
  d5: dist(B, D)

where
  B (-0.04802237515029004, 0.04567303886092026)
  C (13.94931010880379, -0.22760947730854925)
  A (5.185267097264284, 11.945785697903892)
  D (5.024225614521561, 3.6973576270023805)
  d1 label (0.3, 0.3)
  d2 label (0.3, 0.3)
  d3 label (0.3, 0.3)
  d4 label (0.3, 0.3)
  d5 label (0.3, 0.3)

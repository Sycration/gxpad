sgp 2

given
  triangle OAB
    horiz O A
    d1: |OA| = 14
    d2: |AB| = 15
    d3: |BO| = 13

construct
  l1 = bisect(OB, OA)
  l2 = bisect(AO, AB)
  C = meet(l1, l2)

find
  x_C: x(C)
  y_C: y(C)
  d4: dist(C, AB)

where
  A (14, 3.322767581765994e-166)
  B (5, 12)
  C (6, 4)
  d1 label (0.3, 0.3)
  d2 label (0.3, 0.3)
  d3 label (0.3, 0.3)
  x_C label (0.3, 0.3)
  y_C label (0.3, 0.3)
  d4 label (0.3, 0.3)

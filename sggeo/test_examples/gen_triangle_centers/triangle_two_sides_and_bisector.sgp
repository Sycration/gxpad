sgp 2

given
  segment AB
    d1: |AB| = 4
  segment AC
    d2: |AC| = 5
  segment BC

construct
  l1 = bisect(AB, AC)
  D = meet(l1, BC)
    d3: dist(A, D) = 3

find
  d4: |BC|

where
  A (-0.07921840471400658, -0.0471696247280881)
  B (3.920238029677018, 0.018771480875561707)
  C (-0.6050092248851509, 4.925107923179285)
  D (1.9090170276493874, 2.1993654552327717)
  d1 label (0.3, 0.3)
  d2 label (0.3, 0.3)
  d3 label (0.3, 0.3)
  d4 label (0.3, 0.3)

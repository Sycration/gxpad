sgp 2

given
  l1 = segment BC
    d1: len(l1) = 14
  segment CA
    d2: |CA| = 15
  segment AB
    d3: |AB| = 13
  l3 = line BC

construct
  l2 = bisect(AB, AC)
  D = meet(l2, l3)

find
  d4: dist(B, D)
  d5: dist(D, C)

where
  B (-0.031203432307114178, 0.04042156277255396)
  C (13.966323095029653, -0.22273450594619512)
  A (5.193475529214944, 11.94431713309023)
  D (6.467648169670671, -0.08175804056115096)
  d1 label (0.3, 0.3)
  d2 label (0.3, 0.3)
  d3 label (0.3, 0.3)
  d4 label (0.3, 0.3)
  d5 label (0.3, 0.3)

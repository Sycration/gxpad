sgp 2

given
  u = 120
  v = 100
  segment OA
    horiz O A
  segment OB
    θ1: ∠AOB = u*deg
  segment OC
    θ2: ∠BOC = v*deg
    d1: |OC| = 2

find
  y_C: y(C)

where
  A (3, -2.465190328815662e-32)
  B (-1.5009135742041326, 2.599658568291359)
  C (-1.5320888862379562, -1.2855752193730785)
  θ1 label (0.242405, 0.43731)
  θ2 label (-0.495722, 0.0652631)

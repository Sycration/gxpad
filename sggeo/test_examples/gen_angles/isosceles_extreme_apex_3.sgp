sgp 2

given
  l1 = segment AB
    d1: len(l1) = 3
  segment AC
    len(l1) == |AC|
    θ1: angle(l1, AC) = 160°
  l2 = segment BA
  segment BC

find
  θ2: angle(l2, BC)

where
  A (0.0028548636292807478, 0.01617554465766024)
  B (3.0027505051666985, 0.04119833196851124)
  C (-2.824683231153704, 1.0186865533508354)
  d1 label (0.3, 0.3)
  θ1 label (0.165428, 0.986222)
  θ2 label (-0.996887, 0.0788435)

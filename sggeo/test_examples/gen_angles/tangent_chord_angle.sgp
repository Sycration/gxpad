sgp 2

given
  k1 = circle(O)
    r1: r(k1) = 2

construct
  point A on k1
    y_A: y(A) = 0
  point B on k1
  segment AC
    AC tan k1
  segment OA
  segment OB
    θ1: ∠AOB = 80°
  segment AB

find
  θ2: ∠CAB

where
  k1 r 2
  A (2, -1.9721522630525295e-30)
  B (0.34729635533386083, 1.9696155060244163)
  C (2, 1.5)
  r1 label (0.3, 0.3)
  y_A label (0.3, 0.3)
  θ1 label (0.776534, 0.630075)
  θ2 label (-0.34202, 0.939693)

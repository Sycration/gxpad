sgp 2

given
  l1 = segment AB
    d1: len(l1) = 3
  segment AC
    len(l1) == |AC|
    θ1: angle(l1, AC) = 178°
  l2 = segment BA
  segment BC

find
  θ2: angle(l2, BC)

where
  A (0.00029086165920041794, 0.016662801930603946)
  B (3.0001866850415193, 0.041663778977894736)
  C (-2.9986500277580075, 0.09637190919900475)
  d1 label (0.3, 0.3)
  θ1 label (0.00911941, 0.999958)
  θ2 label (-1, 0.000392891)

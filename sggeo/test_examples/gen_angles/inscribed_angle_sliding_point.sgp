sgp 2

given
  k1 = circle(O)
    r1: r(k1) = 3

construct
  point A on k1
    y_A: y(A) = 0
  point B on k1
  point C on k1
  segment OA
  segment OB
    θ1: ∠AOB = 100°
  segment CA
  segment CB

find
  θ2: ∠ACB

where
  k1 r 3
  A (3, 3.858269472273908e-59)
  B (-0.5209445330007909, 2.9544232590366244)
  C (-2.298133329356934, -1.9283628290596178)
  r1 label (0.3, 0.3)
  y_A label (0.3, 0.3)
  θ1 label (0.642788, 0.766044)
  θ2 label (0.707107, 0.707107)

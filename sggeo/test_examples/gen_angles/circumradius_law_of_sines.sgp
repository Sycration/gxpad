sgp 2

given
  point A
  k1 = circle(A)

construct
  point B on k1
  point C on k1
  point D on k1
  segment BC
  segment BD
    θ1: ∠CBD = 30°
  segment CD
    d1: |CD| = 5

find
  r1: r(k1)

where
  A (2.0000000000000004, 1.915063509461096)
  k1 r 5
  B (1.9999999999999996, 6.915063509461096)
  C (-0.5000000000000014, -2.415063509461096)
  D (4.499999999999998, -2.415063509461099)
  θ1 label (-0.000000000000000222045, -1)
  d1 label (0.3, 0.3)
  r1 label (0.3, 0.3)

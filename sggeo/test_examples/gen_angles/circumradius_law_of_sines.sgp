sgp 2

given
  point A
  k1 = circle(A)

construct
  point B on k1
  point C on k1
  point D on k1
  segment BC
  segment BD
    θ1: ∠CBD = 30°
  segment CD
    d1: |CD| = 5

find
  r1: r(k1)

where
  A (2.0000000000000004, 1.9150635094610966)
  k1 r 5.000000000000001
  B (1.9999999999999998, 6.915063509461098)
  C (-0.4999999999999999, -2.4150635094610973)
  D (4.5, -2.4150635094610986)
  θ1 label (-0.000000000000000222045, -1)
  d1 label (0.3, 0.3)
  r1 label (0.3, 0.3)

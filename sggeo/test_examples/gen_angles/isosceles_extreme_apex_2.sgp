sgp 2

given
  l1 = segment AB
    d1: len(l1) = 3
  segment AC
    len(l1) == |AC|
    θ1: angle(l1, AC) = 20°
  l2 = segment BA
  segment BC

find
  θ2: angle(l2, BC)

where
  A (0.002924903137823901, 0.00047451337474909794)
  B (3.002820218682787, 0.025536352321361405)
  C (2.8133327405371147, 1.0500495642808958)
  d1 label (0.3, 0.3)
  θ1 label (0.983323, 0.181869)
  θ2 label (-0.771388, 0.636366)

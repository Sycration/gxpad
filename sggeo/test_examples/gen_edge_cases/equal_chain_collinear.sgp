sgp 2

given
  segment OA
    horiz O A
    d1: |OA| = 1.5
  segment AB
    horiz A B
    |OA| == |AB|
  segment BC
    horiz B C
    |OA| == |BC|
  segment CD
    horiz C D
    |OA| == |CD|

find
  d2: dist(O, D)

where
  A (1.5, 0)
  B (3, 0)
  C (4.5, 0)
  D (6, 0)
  d1 label (0.3, 0.3)
  d2 label (0.3, 0.3)

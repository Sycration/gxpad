sgp 2

given
  triangle ABC
    |AB| == |BC|
    |BC| == |CA|
    d1: |AB| = 1/3

find
  d2: dist(C, AB)

where
  A (0.007509459491755738, 0.0023297389109172627)
  B (0.34083019755152655, 0.005227443243789361)
  C (0.17166034295671773, 0.29244281784529347)
  d1 label (0.3, 0.3)
  d2 label (0.3, 0.3)

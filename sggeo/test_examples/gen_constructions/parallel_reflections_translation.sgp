sgp 2

given
  point C D
  line AB
    d1: dist(C, AB) = 1.2

construct
  l1 = par(AB, C)
  E = reflect(D, AB)
  F = reflect(E, l1)

find
  d2: dist(D, F)

where
  C (1.0980863129078713, 1.7168623869919384)
  D (2, 4)
  A (-0.009068817997891653, 0.14482354490585214)
  B (3.9019136870921285, 1.2831376130080618)
  E (3.755074010649344, -2.030026284601304)
  F (1.3292974531299242, 6.304378027499393)
  d1 label (0.3, 0.3)
  d2 label (0.3, 0.3)

sgp 2

given
  point C D
  line AB
    d1: dist(C, AB) = 1.2

construct
  l1 = par(AB, C)
  E = reflect(D, AB)
  F = reflect(E, l1)

find
  d2: dist(D, F)

where
  C (1.098086312907869, 1.7168623869919373)
  D (2, 4)
  A (-0.009068817997896968, 0.14482354490585023)
  B (3.901913687092131, 1.2831376130080625)
  E (3.755074010649345, -2.0300262846013046)
  F (1.329297453129925, 6.304378027499394)
  d1 label (0.3, 0.3)
  d2 label (0.3, 0.3)

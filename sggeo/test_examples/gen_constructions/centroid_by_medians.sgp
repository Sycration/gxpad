sgp 2

given
  triangle ABC
    d1: |AB| = 6.020797289396148
    d2: |BC| = 5.656854249492381
    d3: |CA| = 4.924428900898052

construct
  D = mid(BC)
  E = mid(CA)
  line AD
  line BE
  F = meet(AD, BE)

find
  d4: dist(A, F)
  d5: dist(F, D)
  d6: dist(A, D)

where
  A (0, 0)
  B (6, 0.5)
  C (2, 4.5)
  D (4, 2.5)
  E (1, 2.25)
  F (2.6666666666666665, 1.6666666666666667)
  d1 label (0.3, 0.3)
  d2 label (0.3, 0.3)
  d3 label (0.3, 0.3)
  d4 label (0.3, 0.3)
  d5 label (0.3, 0.3)
  d6 label (0.3, 0.3)

sgp 2

given
  segment AB
    d1: |AB| = 3
  k1 = circle(A)
    r(k1) == |AB|
  k2 = circle(B)
    r(k2) == |AB|

construct
  C = meet(k1, k2)
  D = mid(AB)

find
  d2: dist(D, C)
  d3: dist(A, C)

where
  A (0.047356384469099747, -0.009972834491998801)
  B (3.043248912648735, 0.1469601435509645)
  k1 r 3
  k2 r 3
  C (1.4093947028821658, 2.6630126909410343)
  D (1.5453026485589174, 0.06849365452948286)
  d1 label (0.3, 0.3)
  d2 label (0.3, 0.3)
  d3 label (0.3, 0.3)

sgp 2

given
  triangle ABC
    d1: |AB| = 6.020797289396148
    d2: |BC| = 5.656854249492381
    d3: |CA| = 4.924428900898052

construct
  l1 = par(BC, A)
  l2 = par(CA, B)
  D = meet(l1, l2)
  l3 = par(AB, C)
  E = meet(l3, l1)
  F = meet(l3, l2)

find
  d4: dist(C, D)
  d5: dist(E, F)

where
  A (0, 0)
  B (6, 0.5)
  C (2, 4.5)
  D (4, -4)
  E (-4, 4)
  F (8, 5)
  d1 label (0.3, 0.3)
  d2 label (0.3, 0.3)
  d3 label (0.3, 0.3)
  d4 label (0.3, 0.3)
  d5 label (0.3, 0.3)

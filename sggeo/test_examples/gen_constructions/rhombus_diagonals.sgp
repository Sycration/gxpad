sgp 2

given
  polygon ACBD
    |AC| == |CB|
    |AC| == |BD|
    |AC| == |DA|
    d1: |AC| = 3
  segment AB
    d2: |AB| = 4
  line CD

construct
  E = mid(A, B)
  l1 = perp(AB, E)
  F = meet(l1, AB)

find
  d3: dist(F, C)
  d4: dist(F, D)
  d5: dist(C, D)

where
  A (0.0004823148289315117, 0.03490738433115226)
  C (2.0488236408334997, -2.1569634631828722)
  B (3.9995289214736296, 0.12223571812680689)
  D (1.9511875954690618, 2.3141065656408313)
  E (2.0000056181512806, 0.07857155122897959)
  F (2.0000056181512806, 0.07857155122897959)
  d1 label (0.3, 0.3)
  d2 label (0.3, 0.3)
  d3 label (0.3, 0.3)
  d4 label (0.3, 0.3)
  d5 label (0.3, 0.3)

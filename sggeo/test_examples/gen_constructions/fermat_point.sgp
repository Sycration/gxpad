sgp 2

given
  triangle ABC
    d1: |AB| = 5
    d2: |BC| = 4.949747468305833
    d3: |CA| = 3.8078865529319543
  k1 = circle(A)
    r(k1) == |AB|
  k2 = circle(B)
    r(k2) == |AB|
  k3 = circle(B)
    r(k3) == |BC|
  k4 = circle(C)
    r(k4) == |BC|

construct
  D = meet(k1, k2)
  E = meet(k3, k4)
  line CD
  line AE
  F = meet(CD, AE)

find
  d4: dist(C, D)
  d5: dist(F, A)
  d6: dist(F, B)
  d7: dist(F, C)

where
  A (7.908258903350622e-17, 2.959752098027317e-16)
  B (5, 5.871544235289647e-16)
  C (1.5000000000000002, 3.5000000000000004)
  k1 r 5
  k2 r 5
  k3 r 4.949747468305833
  k4 r 4.949747468305833
  D (2.5000000000000004, -4.330127018922193)
  E (6.281088913245535, 4.781088913245535)
  F (1.7744886158575104, 1.3507192725875536)
  d1 label (0.3, 0.3)
  d2 label (0.3, 0.3)
  d3 label (0.3, 0.3)
  d4 label (0.3, 0.3)
  d5 label (0.3, 0.3)

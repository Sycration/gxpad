sgp 2

given
  line OA
    θ1: angle(xaxis, OA) = 60°
  line OB
    θ2: angle(xaxis, OB) = 80°
  segment OC
    d1: |OC| = 3

construct
  D = reflect(C, OA)
  E = reflect(D, OB)

find
  d2: dist(C, E)
  d3: dist(O, E)

where
  A (0.9861866987566675, 1.7081254679951705)
  B (0.1941473126687256, 1.101064124665778)
  C (2.993355473569827, 0.19955703157132185)
  D (-1.3238562779403347, 2.6921003984543304)
  E (2.1647705394880714, 2.076961364918598)
  θ1 label (0.3, 0.3)
  θ2 label (0.3, 0.3)
  d1 label (0.3, 0.3)
  d2 label (0.3, 0.3)
  d3 label (0.3, 0.3)

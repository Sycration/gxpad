sgp 2

given
  triangle ABC
    d1: |AB| = 6.020797289396148
    d2: |BC| = 5.656854249492381
    d3: |CA| = 4.924428900898052

construct
  l1 = perp(BC, A)
  D = meet(l1, BC)
  l2 = perp(CA, B)
  E = meet(l2, CA)
  l3 = perp(BC, A)
  l4 = perp(CA, B)
  F = meet(l3, l4)

find
  d4: dist(F, A)
  d5: dist(D, E)
  d6: dist(F, D)

where
  A (0, 0)
  B (6, 0.5)
  C (2, 4.5)
  D (3.25, 3.25)
  E (1.175257731958763, 2.644329896907217)
  F (2.1923076923076925, 2.1923076923076925)
  d1 label (0.3, 0.3)
  d2 label (0.3, 0.3)
  d3 label (0.3, 0.3)
  d4 label (0.3, 0.3)
  d5 label (0.3, 0.3)
  d6 label (0.3, 0.3)

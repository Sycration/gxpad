sgp 2

given
  l1 = segment OB
  l2 = segment BO
  segment OC
  segment OD
  segment BF
    θ6: angle(l2, BF) = (pi - θ1 - (pi - θ2))/3

construct
  point A on xaxis
  segment OA
    d1: |OA| = 6
    θ1: angle(OA, l1) = 50°
    θ3: ∠AOC = θ1/3
    θ4: ∠AOD = 2*θ1/3
  segment AB
    θ2: angle(OA, AB) = 110°
  segment AE
    θ5: angle(OA, AE) = pi - (pi - θ2)/3
  G = meet(OC, AE)
  H = meet(OD, BF)

find
  d2: dist(G, H)

where
  B (4.184792530904096, 4.9872415329663715)
  C (3.500597015166967, 1.0480099494429997)
  D (3.105114474082697, 2.042265917153787)
  F (3.1138608307601734, 2.0448808690427978)
  A (6, -1.9710239362917936e-19)
  E (3.5404143795099468, 1.0609616732022764)
  G (3.541825537902843, 1.060352958889911)
  H (3.11536225043232, 2.049005985689145)
  θ6 label (-0.251021, -0.432422)
  d1 label (0.3, 0.3)
  θ1 label (0.453065, 0.211499)
  θ3 label (0.4947, 0.0726066)
  θ4 label (0.478816, 0.143999)
  θ2 label (0.286756, 0.409599)
  θ5 label (0.101013, 0.48969)
  d2 label (0.3, 0.3)

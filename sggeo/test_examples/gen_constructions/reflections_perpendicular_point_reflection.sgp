sgp 2

given
  line AB
  line AC
    AB ⟂ AC
  segment AD
    d1: |AD| = 3

construct
  E = reflect(D, AB)
  F = reflect(E, AC)
  G = mid(D, F)

find
  d2: dist(D, F)
  d3: dist(D, E)
  d4: dist(G, A)

where
  A (0.389430115793585, 0.3448275621819366)
  B (3.0088947540049022, 0.6156086910883212)
  C (0.11577518352925162, 2.9920926099111647)
  D (2.185899946672262, 2.747471136818578)
  E (2.639395584477929, -1.6395250752613286)
  F (-1.4070397150850928, -2.0578160124547047)
  G (0.38943011579358455, 0.34482756218193655)
  d1 label (0.3, 0.3)
  d2 label (0.3, 0.3)
  d3 label (0.3, 0.3)
  d4 label (0.3, 0.3)

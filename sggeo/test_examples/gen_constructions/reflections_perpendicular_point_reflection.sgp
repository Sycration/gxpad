sgp 2

given
  line AB
  line AC
    AB ⟂ AC
  segment AD
    d1: |AD| = 3

construct
  E = reflect(D, AB)
  F = reflect(E, AC)
  G = mid(D, F)

find
  d2: dist(D, F)
  d3: dist(D, E)
  d4: dist(G, A)

where
  A (0.3894301157935818, 0.3448275621819413)
  B (3.008894754004901, 0.6156086910883198)
  C (0.11577518352925585, 2.992092609911159)
  D (2.185899946672262, 2.7474711368185805)
  E (2.6393955844779184, -1.639525075261332)
  F (-1.4070397150850986, -2.0578160124546967)
  G (0.38943011579358167, 0.3448275621819419)
  d1 label (0.3, 0.3)
  d2 label (0.3, 0.3)
  d3 label (0.3, 0.3)
  d4 label (0.3, 0.3)

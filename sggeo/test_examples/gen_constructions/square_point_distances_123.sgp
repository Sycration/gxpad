sgp 2

given
  polygon ABCD
    AB ⟂ BC
    BC ⟂ CD
    CD ⟂ DA
    |AB| == |BC|
  point E
    d1: dist(E, A) = 1
    d2: dist(E, B) = 2
    d3: dist(E, C) = 3

find
  d4: |AB|

where
  A (-0.08812938128650594, 0.1065460042194383)
  B (2.709175498638154, 0.04727937367682902)
  C (2.7684421291807633, 2.844584253601489)
  D (-0.028862750743896663, 2.903850884144098)
  E (0.7852398080751104, 0.5936047882217731)
  d1 label (0.3, 0.3)
  d2 label (0.3, 0.3)
  d3 label (0.3, 0.3)
  d4 label (0.3, 0.3)

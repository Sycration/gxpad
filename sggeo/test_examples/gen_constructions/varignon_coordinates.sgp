sgp 2

given
  polygon OABC
    x_A: x(A) = 4
    y_A: y(A) = 0
    x_B: x(B) = 5
    y_B: y(B) = 3
    x_C: x(C) = 0
    y_C: y(C) = 2

construct
  D = mid(OA)
  E = mid(AB)
  F = mid(BC)
  G = mid(CO)
  H = mid(D, F)
  I = mid(E, G)

find
  x_H: x(H)
  y_H: y(H)
  x_I: x(I)
  y_I: y(I)
  x_E: x(E)

where
  A (4, 0)
  B (5, 3)
  C (0, 2)
  D (2, 0)
  E (4.5, 1.5)
  F (2.5, 2.5)
  G (0, 1)
  H (2.25, 1.25)
  I (2.25, 1.25)
  x_A label (0.3, 0.3)
  y_A label (0.3, 0.3)
  x_B label (0.3, 0.3)
  y_B label (0.3, 0.3)
  x_C label (0.3, 0.3)
  y_C label (0.3, 0.3)
  x_H label (0.3, 0.3)
  y_H label (0.3, 0.3)
  x_I label (0.3, 0.3)
  y_I label (0.3, 0.3)
  x_E label (0.3, 0.3)

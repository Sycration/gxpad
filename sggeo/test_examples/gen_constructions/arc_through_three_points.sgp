sgp 2

given
  point A
    x_A: x(A) = -3
    y_A: y(A) = 0
  point B
    x_B: x(B) = 0
    y_B: y(B) = 1
  point C
    x_C: x(C) = 3
    y_C: y(C) = 0
  point D
  w1 = arc(D, C, A)
    B on w1

find
  r1: r(w1)
  y_D: y(D)

where
  A (-3, 0)
  B (0, 1)
  C (3, 0)
  D (0, -4)
  x_A label (0.3, 0.3)
  y_A label (0.3, 0.3)
  x_B label (0.3, 0.3)
  y_B label (0.3, 0.3)
  x_C label (0.3, 0.3)
  y_C label (0.3, 0.3)
  r1 label (0.3, 0.3)
  y_D label (0.3, 0.3)

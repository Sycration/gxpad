sgp 2

given
  triangle ABC
    d1: |AB| = 6
    d2: |BC| = 5
    d3: |CA| = 4

construct
  D = mid(BC)
  E = mid(CA)
  line AD
  line BE
  F = meet(AD, BE)

find
  d4: dist(A, F)
  d5: dist(F, D)

where
  A (-0.04469271253535525, 0.3806256855288679)
  B (5.949783685554067, 0.6380217087088483)
  C (2.061359714708335, 3.781293733677784)
  D (4.005571700131201, 2.209657721193316)
  E (1.00833350108649, 2.080959709603326)
  F (2.6554835625756823, 1.5999803759718334)
  d1 label (0.3, 0.3)
  d2 label (0.3, 0.3)
  d3 label (0.3, 0.3)
  d4 label (0.3, 0.3)
  d5 label (0.3, 0.3)

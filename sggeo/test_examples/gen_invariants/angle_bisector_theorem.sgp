sgp 2

given
  segment AB
    d1: |AB| = 3
  l1 = segment BC
    d2: len(l1) = 6
  segment CA
    d3: |CA| = 5
  l3 = line BC

construct
  l2 = bisect(AB, AC)
  D = meet(l2, l3)

find
  d4: dist(B, D)
  d5: dist(D, C)

where
  A (0.607745021069577, 0.7891070345074662)
  B (2.813079228844572, -1.2447319542075783)
  C (3.744898409376573, 4.682469157176501)
  D (3.1625114215440724, 0.9779684625614514)
  d1 label (0.3, 0.3)
  d2 label (0.3, 0.3)
  d3 label (0.3, 0.3)
  d4 label (0.3, 0.3)
  d5 label (0.3, 0.3)

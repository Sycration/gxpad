sgp 2

given
  point A
  k1 = circle(A)
    r1: r(k1) = 5
  k2 = circle(A)
    r2: r(k2) = 3

construct
  point B on k1
  C = tangent(B, k2)
  segment BC

find
  d1: |BC|

where
  A (1.4185362094346314, 0.9177147785468276)
  k1 r 5
  k2 r 3
  B (5.755959167710984, 3.40503503959429)
  C (1.7860947491113364, 3.895113092496563)
  r1 label (0.3, 0.3)
  r2 label (0.3, 0.3)
  d1 label (0.3, 0.3)

sgp 2

given
  k1 = circle(O)
    r1: r(k1) = 2

construct
  point A on k1
  point B on k1
  segment OA
  segment OB
    θ1: ∠AOB = 84°
  segment AB
  l1 = perp(OA, A)

find
  θ2: angle(AB, -l1)

where
  k1 r 2
  A (1.9487401295704705, 0.4499021086877299)
  B (-0.24373868681029487, 1.9850923032826442)
  r1 label (0.3, 0.3)
  θ1 label (0.3, 0.3)
  θ2 label (0.3, 0.3)

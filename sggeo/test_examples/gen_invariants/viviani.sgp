sgp 2

given
  triangle ABC
    |AB| == |BC|
    |BC| == |CA|
    d1: |AB| = 4
  point D
    d2: dist(D, AB) = 1
    d3: dist(D, BC) = 1.3

find
  d4: dist(D, CA)

where
  A (0.03472848146401929, 0.0325708560395601)
  B (4.034370250648453, 0.0861032592661681)
  C (1.9881889449363614, 3.5231284358039194)
  D (1.9427123229511676, 1.0581974488903516)
  d1 label (0.3, 0.3)
  d2 label (0.3, 0.3)
  d3 label (0.3, 0.3)
  d4 label (0.3, 0.3)

sgp 2

given
  triangle ABC
    |AB| == |BC|
    |BC| == |CA|
    d1: |AB| = 4
  point D
    d2: dist(D, AB) = 1
    d3: dist(D, BC) = 1.3

find
  d4: dist(D, CA)

where
  A (0.034728481464019106, 0.03257085603956056)
  B (4.034370250648452, 0.08610325926616812)
  C (1.9881889449363612, 3.52312843580392)
  D (1.942712322951167, 1.058197448890352)
  d1 label (0.3, 0.3)
  d2 label (0.3, 0.3)
  d3 label (0.3, 0.3)
  d4 label (0.3, 0.3)

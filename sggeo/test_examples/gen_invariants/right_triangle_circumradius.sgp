sgp 2

given
  segment AB
    d1: |AB| = 6
  segment AC
    AB ⟂ AC
    d2: |AC| = 8
  segment BC

construct
  D = mid(A, B)
  l1 = perp(AB, D)
  E = mid(A, C)
  l2 = perp(AC, E)
  F = meet(l1, l2)

find
  d3: dist(F, A)
  d4: dist(F, C)

where
  A (0.03838613699054119, 0.05035234520701238)
  B (6.038352441059358, 0.07046080210419983)
  C (0.011574861127624583, 8.050307417298768)
  D (3.0383692890249496, 0.06040657365560611)
  E (0.024980499059082888, 4.050329881252891)
  F (3.0249636510934916, 4.060384109701484)
  d1 label (0.3, 0.3)
  d2 label (0.3, 0.3)
  d3 label (0.3, 0.3)
  d4 label (0.3, 0.3)

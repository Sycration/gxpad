sgp 2

given
  k1 = circle(O)
    r1: r(k1) = 3
  point A
    d1: dist(O, A) = 1

construct
  point B on k1
  point C on k1
  segment BC
    A on BC
  point D on k1
    d2: dist(A, D) = 2
  point E on k1
  segment DE
    A on DE

find
  d3: dist(A, E)
  d4: dist(A, B)
  d5: dist(A, C)

where
  k1 r 2.999999999999998
  A (0.008197481172842556, 0.999966400086734)
  B (2.4752147308101384, 1.6950846693839459)
  C (-2.9960719495054815, 0.15346945424549008)
  D (0.024592249536708542, 2.999899201850407)
  E (-0.024592055554889438, -2.9998992034406045)
  r1 label (0.3, 0.3)
  d1 label (0.3, 0.3)
  d2 label (0.3, 0.3)
  d3 label (0.3, 0.3)
  d4 label (0.3, 0.3)
  d5 label (0.3, 0.3)

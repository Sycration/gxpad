sgp 2

given
  r = 3
  point A
  k1 = circle(A)
    r1: r(k1) = r

construct
  point B on k1
  point C on k1
  segment BC
    A on BC
  point D on k1
  segment DB
    d1: |DB| = 3
  segment DC

find
  d2: |DC|

where
  A (0.6574377309947901, -0.09459623888618922)
  k1 r 3
  B (-2.181538876420169, 0.8750489655832849)
  C (3.4964143384097492, -1.0642414433556633)
  D (0.07768680701563145, 2.848852226119664)
  r1 label (0.3, 0.3)
  d1 label (0.3, 0.3)
  d2 label (0.3, 0.3)

sgp 2

given
  segment AB
    d1: |AB| = 4
  segment AC
    AB ⟂ AC
    d2: |AC| = 3
  segment BC

construct
  l1 = perp(BC, A)
  D = meet(l1, BC)

find
  d3: dist(A, D)
  d4: dist(B, D)
  d5: dist(C, D)

where
  A (0.11924296997686937, -0.07132611303656987)
  B (4.118489139550315, -0.14897967156497247)
  C (0.1774831388731713, 2.928108514143514)
  D (1.596245299116943, 1.820356767288459)
  d1 label (0.3, 0.3)
  d2 label (0.3, 0.3)
  d3 label (0.3, 0.3)
  d4 label (0.3, 0.3)
  d5 label (0.3, 0.3)

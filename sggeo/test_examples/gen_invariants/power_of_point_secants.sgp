sgp 2

given
  k1 = circle(O)
    r1: r(k1) = 2

construct
  point B on k1
  point C on k1
  segment AC
    B on AC
    O on AC
    d1: dist(O, A) = 5
  point D on k1
  point E on k1
  segment AE
    D on AE
  segment AD
    d2: |AD| = 3.4

find
  d3: dist(A, B)
  d4: dist(A, C)
  d5: dist(A, E)

where
  k1 r 2
  B (1.99985132899027, 0.02438569121126013)
  C (-1.99985132899027, -0.024385691211260135)
  A (4.999628322475675, 0.060964228028150325)
  D (1.7319334198070038, 1.0002032940135803)
  E (-0.9364956356594546, 1.7671943651989144)
  r1 label (0.3, 0.3)
  d1 label (0.3, 0.3)
  d2 label (0.3, 0.3)
  d3 label (0.3, 0.3)
  d4 label (0.3, 0.3)
  d5 label (0.3, 0.3)

sgp 2

given
  triangle ABC
    d1: |AB| = 4
    d2: |CA| = 3
    d3: |BC| = 5
  point D
  k1 = circle(D)
    AB tan k1
    BC tan k1
    CA tan k1
  point E
  k2 = circle(E)
    AB tan k2
    BC tan k2
    CA tan k2

find
  r1: r(k1)
  r2: r(k2)

where
  A (0.02697068510818495, -0.010479156006343266)
  B (4.025895031160075, 0.08227899486710719)
  C (-0.042597928046903044, 2.988714103532575)
  D (1.0035122339027949, 1.0124414682249918)
  k1 r 0.9999999999999999
  E (5.886219977875846, 6.1270445893816685)
  k2 r 6.000000000000001
  d1 label (0.3, 0.3)
  d2 label (0.3, 0.3)
  d3 label (0.3, 0.3)
  r1 label (0.3, 0.3)
  r2 label (0.3, 0.3)

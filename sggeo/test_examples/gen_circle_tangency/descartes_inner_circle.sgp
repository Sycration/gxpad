sgp 2

given
  point A
  k1 = circle(A)
    r1: r(k1) = 1
  point B
  k2 = circle(B)
    k1 tan k2
    r2: r(k2) = 2
  point C
  k3 = circle(C)
    k1 tan k3
    k2 tan k3
    r3: r(k3) = 3
  point D

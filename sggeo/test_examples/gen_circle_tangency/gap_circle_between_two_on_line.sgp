sgp 2

given
  r = 6
  point A
  k1 = circle(A)
    xaxis tan k1
    r1: r(k1) = r
  point B
  k2 = circle(B)
    xaxis tan k2
    k1 tan k2
    r(k1) == r(k2)
  point C
  k3 = circle(C)
    k3 tan k1
    k3 tan k2
    xaxis tan k3

find
  r2: r(k3)

where
  A (-5.966666666666667, 6)
  k1 r 6
  B (6.033333333333333, 6)
  k2 r 6
  C (0.033333333333333326, 1.4999999999999998)
  k3 r 1.4999999999999998
  r1 label (0.3, 0.3)
  r2 label (0.3, 0.3)

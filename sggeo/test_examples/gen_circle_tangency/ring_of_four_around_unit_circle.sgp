sgp 2

given
  point A
  k1 = circle(A)
    r1: r(k1) = 1
  point B
  k2 = circle(B)
    k1 tan k2
  point C
  k3 = circle(C)
    k1 tan k3
    k2 tan k3
    r(k2) == r(k3)
  point D
  k4 = circle(D)
    k1 tan k4
    k3 tan k4
    r(k3) == r(k4)
  point E
  k5 = circle(E)
    k1 tan k5
    k4 tan k5
    k5 tan k2
    r(k4) == r(k5)

find
  r2: r(k2)


sgp 2

given
  line AB
    horiz A B
    y_A: y(A) = 4
  point C
  k1 = circle(C)
    xaxis tan k1
    r1: r(k1) = 1
  point D
  k2 = circle(D)
    xaxis tan k2
    AB tan k2
    k1 tan k2

find
  d1: dx(C, D)

where
  A (0, 4)
  B (3, 4)
  C (0.08578643762690503, 1)
  k1 r 1
  D (2.914213562373095, 2)
  k2 r 2
  y_A label (0.3, 0.3)
  r1 label (0.3, 0.3)
  d1 label (0.3, 0.3)

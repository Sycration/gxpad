sgp 2

given
  point A
  k1 = circle(A)
    r1: r(k1) = 3
  point B
  k2 = circle(B)
    k1 tan k2
    r2: r(k2) = 2

construct
  point C on k1
  point D on k2
  segment CD
    CD tan k1
    CD tan k2

find
  d1: |CD|

where
  A (0.26138592277881084, 0.006292652202863092)
  k1 r 3
  B (5.261069048028615, -0.049998084977895485)
  k2 r 2
  C (0.8944399578099005, 2.938739171532901)
  D (5.683105071382675, 1.90496626124213)
  r1 label (0.3, 0.3)
  r2 label (0.3, 0.3)
  d1 label (0.3, 0.3)

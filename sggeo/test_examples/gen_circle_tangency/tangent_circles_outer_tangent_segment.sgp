sgp 2

given
  point A
  k1 = circle(A)
    r1: r(k1) = 3
  point B
  k2 = circle(B)
    k1 tan k2
    r2: r(k2) = 2

construct
  point C on k1
  point D on k2
  segment CD
    CD tan k1
    CD tan k2

find
  d1: |CD|

where
  A (0.2613859227787751, 0.006292652202946131)
  k1 r 3
  B (5.2610690480285776, -0.04999808497796197)
  k2 r 2
  C (0.8944399578099524, 2.938739171532965)
  D (5.683105071382696, 1.9049662612420508)
  r1 label (0.3, 0.3)
  r2 label (0.3, 0.3)
  d1 label (0.3, 0.3)

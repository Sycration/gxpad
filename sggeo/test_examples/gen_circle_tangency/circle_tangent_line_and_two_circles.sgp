sgp 2

given
  point A
    x_A: x(A) = 0
    y_A: y(A) = 3
  k1 = circle(A)
    r1: r(k1) = 1
  point B
    x_B: x(B) = 6
    y_B: y(B) = 2
  k2 = circle(B)
    r2: r(k2) = 1.5
  point C
  k3 = circle(C)
    xaxis tan k3
    k3 tan k1
    k3 tan k2

find
  r3: r(k3)

where
  A (7.054654234205568e-165, 3)
  k1 r 1
  B (6, 2)
  k2 r 1.5
  C (2.6348151111449782, 1.8677813337397404)
  k3 r 1.8677813337397404
  x_A label (0.3, 0.3)
  y_A label (0.3, 0.3)
  r1 label (0.3, 0.3)
  x_B label (0.3, 0.3)
  y_B label (0.3, 0.3)
  r2 label (0.3, 0.3)
  r3 label (0.3, 0.3)

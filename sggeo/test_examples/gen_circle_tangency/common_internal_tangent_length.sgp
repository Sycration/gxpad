sgp 2

given
  point A
  k1 = circle(A)
    r1: r(k1) = 3
  point B
    d1: dist(A, B) = 8
  k2 = circle(B)
    r2: r(k2) = 2

construct
  point C on k1
  point D on k2
  segment CD
    CD tan k1
    CD tan k2

find
  d2: |CD|

where
  A (-0.07843463216199993, -0.02295313338879847)
  k1 r 3
  B (7.920919489126888, 0.07870139045784309)
  k2 r 2
  C (1.7666562260486574, 2.342557324196934)
  D (6.69085891698645, -1.4983055812659785)
  r1 label (0.3, 0.3)
  d1 label (0.3, 0.3)
  r2 label (0.3, 0.3)
  d2 label (0.3, 0.3)

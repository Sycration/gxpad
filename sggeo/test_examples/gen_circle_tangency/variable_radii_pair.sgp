sgp 2

given
  a = 3
  point A
  k1 = circle(A)
    r1: r(k1) = a
  point B
  k2 = circle(B)
    k1 tan k2
    r2: r(k2) = 2a

find
  d1: dist(A, B)

where
  A (-1.3947412823690015, -0.06748748140495169)
  k1 r 3
  B (7.594741282369002, 0.3674874814049517)
  k2 r 6
  r1 label (0.3, 0.3)
  r2 label (0.3, 0.3)
  d1 label (0.3, 0.3)

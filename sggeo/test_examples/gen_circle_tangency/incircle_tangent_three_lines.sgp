sgp 2

given
  segment OA
    horiz O A
    d1: |OA| = 4
  segment OB
    OA ⟂ OB
    d2: |OB| = 3
  segment AB
  point C
  k1 = circle(C)
    OA tan k1
    OB tan k1
    AB tan k1

find
  r1: r(k1)

where
  A (4, -2.6301712188100836e-192)
  B (-2.404414855862218e-190, 3)
  C (1, 1)
  k1 r 1
  d1 label (0.3, 0.3)
  d2 label (0.3, 0.3)
  r1 label (0.3, 0.3)

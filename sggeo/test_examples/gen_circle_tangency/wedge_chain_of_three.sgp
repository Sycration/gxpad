sgp 2

given
  line OA
    θ1: angle(xaxis, OA) = 60°
  point B
  k1 = circle(B)
    xaxis tan k1
    OA tan k1
    r1: r(k1) = 9
  point C
  k2 = circle(C)
    xaxis tan k2
    OA tan k2
    k1 tan k2
  point D
  k3 = circle(D)
    xaxis tan k3
    OA tan k3
    k2 tan k3

find
  r2: r(k2)
  r3: r(k3)

where
  A (9.861855070027916, 17.081234038168834)
  B (15.588457268120006, 9.000000000000002)
  k1 r 9
  C (5.196152422706706, 3.0000000000000204)
  k2 r 3.0000000000000204
  D (1.732050807568914, 1.0000000000000142)
  k3 r 1.0000000000000142
  θ1 label (0.3, 0.3)
  r1 label (0.3, 0.3)
  r2 label (0.3, 0.3)
  r3 label (0.3, 0.3)

sgp 2

given
  line OA
    θ1: angle(xaxis, OA) = 60°
  point B
  k1 = circle(B)
    xaxis tan k1
    OA tan k1
    r1: r(k1) = 1.5

find
  d1: dist(O, B)

where
  A (2.0151073019024413, 3.4902682295980636)
  B (2.5980762113533165, 1.5)
  k1 r 1.5
  θ1 label (0.3, 0.3)
  r1 label (0.3, 0.3)
  d1 label (0.3, 0.3)

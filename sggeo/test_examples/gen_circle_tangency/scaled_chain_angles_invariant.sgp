sgp 2

given
  s = 2
  point A
  k1 = circle(A)
    r1: r(k1) = 2s
  point B
  k2 = circle(B)
    k1 tan k2
    r2: r(k2) = 3s
  point C
  k3 = circle(C)
    k1 tan k3
    k2 tan k3
    r3: r(k3) = 6s
  segment AB
  l1 = segment AC
  l2 = segment CA
  segment CB

find
  θ1: angle(AB, l1)
  θ2: angle(l2, BC)

where
  A (-1.9889145254937761, -2.4323178937265486)
  k1 r 4
  B (8.010532711734221, -2.5374604155404437)
  k2 r 6
  C (-0.2216181862404451, 13.469778309266998)
  k3 r 12
  r1 label (0.3, 0.3)
  r2 label (0.3, 0.3)
  r3 label (0.3, 0.3)
  θ1 label (0.3, 0.3)
  θ2 label (0.3, 0.3)

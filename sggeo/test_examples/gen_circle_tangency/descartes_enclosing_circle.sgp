sgp 2

given
  point A
  k1 = circle(A)
    r1: r(k1) = 1
  point B
  k2 = circle(B)
    k1 tan k2
    r2: r(k2) = 1
  point C
  k3 = circle(C)
    k1 tan k3
    k2 tan k3
    r3: r(k3) = 1
  point D
  k4 = circle(D)
    k4 tan k1 inside
    k4 tan k2 inside
    k4 tan k3 inside

find
  r4: r(k4)

where
  A (0.007336485685258633, -0.000024701191081684058)
  k1 r 1
  B (2.0071784665636567, 0.025115933573475864)
  k2 r 1
  C (0.9854850477510846, 1.7444595751864835)
  k3 r 1
  D (1, 0.5898502691896259)
  k4 r 2.1547005383792515
  r1 label (0.3, 0.3)
  r2 label (0.3, 0.3)
  r3 label (0.3, 0.3)
  r4 label (0.3, 0.3)

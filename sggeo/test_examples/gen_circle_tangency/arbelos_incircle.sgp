sgp 2

given
  point D
  k4 = circle(D)

construct
  point A on xaxis
  k1 = circle(A)
    k4 tan k1 inside
  point B on xaxis
  point C on xaxis
  k2 = circle(B)
    k1 tan k2 inside
    k4 tan k2
    r1: r(k2) = 3
  k3 = circle(C)
    k1 tan k3 inside
    k2 tan k3
    k4 tan k3
    r2: r(k3) = 2

find
  r3: r(k4)

where
  D (1.3118421052631577, 3.1578947368421053)
  k4 r 1.5789473684210529
  A (-0.003947368421052524, 1.1914863900415996e-25)
  k1 r 5
  B (-2.003947368421053, 6.461140592309409e-27)
  C (2.9960526315789475, 1.0824433797080636e-25)
  k2 r 3
  k3 r 2
  r1 label (0.3, 0.3)
  r2 label (0.3, 0.3)
  r3 label (0.3, 0.3)

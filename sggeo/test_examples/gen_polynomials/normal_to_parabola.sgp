sgp 2

given
  g1 = curve(y = x^2)

construct
  point B on g1
  segment BC
    BC tan g1
  segment AB
    AB ⟂ BC
    x_A: x(A) = 1
    y_A: y(A) = 3

find
  x_B: x(B)

where
  B (1.6729816478549422, 2.7988675940594376)
  C (2.6729820341341717, 6.1448321822454455)
  A (1, 3)
  x_A label (0.3, 0.3)
  y_A label (0.3, 0.3)
  x_B label (0.3, 0.3)

sgp 2

given
  a = 1
  g1 = curve(y = x^12 + (1 - a)*x^10 + a*x^9 + (4 - a)*x^8 + (a - a^2)*x^7 + (2 - a)*x^6 + (5*a - a^2)*x^5 + (a + 1)*x^4 + (3*a - 2*a^2)*x^3 + (2*a - 3)*x^2 + 6*a*x - 6)

construct
  A = meet(g1, xaxis)

find
  x_A: x(A)

where
  A (0.7244919590005157, -8.242980161977369e-32)
  x_A label (0.3, 0.3)

sgp 2

construct
  point A on xaxis
  point B on yaxis
  segment AB
    d1: |AB| = 5
    θ1: angle(xaxis, AB) = 145°
  point C on AB
  segment AC
    d2: |AC| = 2

find
  x_C: x(C)
  y_C: y(C)

where
  A (4.0957602214449595, 7.859911940229327e-49)
  B (1.3967074897918506e-48, 2.86788218175523)
  C (2.4574561328669757, 1.1471528727020919)
  d1 label (0.3, 0.3)
  θ1 label (0.3, 0.3)
  d2 label (0.3, 0.3)
  x_C label (0.3, 0.3)
  y_C label (0.3, 0.3)

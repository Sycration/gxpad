sgp 2

given
  polygon ABCD
    horiz A B
    CD ∥ AB
    |BC| == |DA|
    d1: |AB| = 6
    d2: |CD| = 3
    d3: |BC| = 2.5

find
  d4: dist(C, AB)
  d5: dist(A, C)

where
  A (-7.072033958812417e-16, 0.025000000000000012)
  B (5.999999999999999, 0.025000000000000012)
  C (4.499999999999999, 2.025)
  D (1.4999999999999993, 2.025)
  d1 label (0.3, 0.3)
  d2 label (0.3, 0.3)
  d3 label (0.3, 0.3)
  d4 label (0.3, 0.3)
  d5 label (0.3, 0.3)

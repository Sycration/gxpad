sgp 2

given
  polygon ABCD
    horiz A B
    CD ∥ AB
    |BC| == |DA|
    d1: |AB| = 6
    d2: |CD| = 3
    d3: |BC| = 2.5

find
  d4: dist(C, AB)
  d5: dist(A, C)

where
  A (1.551086683381237e-16, 0.025000000000000154)
  B (6, 0.025000000000000154)
  C (4.5, 2.0250000000000004)
  D (1.5000000000000002, 2.0250000000000004)
  d1 label (0.3, 0.3)
  d2 label (0.3, 0.3)
  d3 label (0.3, 0.3)
  d4 label (0.3, 0.3)
  d5 label (0.3, 0.3)

sgp 2

given
  k1 = circle(O)

construct
  point A on k1
  point B on k1
  point C on k1
  point D on k1
  polygon ABCD
    |BC| == |AB|
    |CD| == |AB|
    d1: |AB| = 2
    d2: |DA| = 3

find
  r1: r(k1)

where
  k1 r 1.632993161855452
  A (1.6329895321637917, -0.0034430379241984347)
  B (0.4115810901761433, 1.580274556169302)
  C (-1.42719898707572, 0.7935803160088495)
  D (-1.1251805837140034, -1.183484398164877)
  d1 label (0.3, 0.3)
  d2 label (0.3, 0.3)
  r1 label (0.3, 0.3)

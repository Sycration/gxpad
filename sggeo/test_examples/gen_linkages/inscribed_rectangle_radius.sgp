sgp 2

given
  point A
  k1 = circle(A)

construct
  point B on k1
  point C on k1
  point D on k1
  point E on k1
  segment BC
    d1: |BC| = 6
  segment CD
    BC ⟂ CD
    d2: |CD| = 8
  segment BE
    d3: |BE| = 8

find
  r1: r(k1)
  d4: dist(C, E)

where
  A (0.01999999999999993, -0.019999999999999987)
  k1 r 5
  B (-2.983999200967285, -4.016997473177574)
  C (3.015997797979631, -4.0229985254183145)
  D (3.023999200967285, 3.976997473177574)
  E (-2.9759977979796304, 3.982998525418315)
  d1 label (0.3, 0.3)
  d2 label (0.3, 0.3)
  d3 label (0.3, 0.3)
  r1 label (0.3, 0.3)
  d4 label (0.3, 0.3)

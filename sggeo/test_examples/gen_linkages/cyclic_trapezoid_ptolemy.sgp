sgp 2

given
  point A
  k1 = circle(A)

construct
  point B on k1
  point C on k1
  point D on k1
  point E on k1
  polygon BCDE
    d1: |BC| = 6
    d2: |DE| = 2
    d3: |CD| = 3
    d4: |EB| = 3

find
  d5: dist(B, D)

where
  A (0.0000021412817541212416, 0.0030835055982633324)
  k1 r 3.074085229787879
  B (-2.9999988624407097, -0.6677323988525835)
  C (3.0000011375525735, -0.6677413764492609)
  D (0.9999977918020717, -2.903806361414322)
  E (-1.0000022081956894, -2.903803368882096)
  d1 label (0.3, 0.3)
  d2 label (0.3, 0.3)
  d3 label (0.3, 0.3)
  d4 label (0.3, 0.3)
  d5 label (0.3, 0.3)

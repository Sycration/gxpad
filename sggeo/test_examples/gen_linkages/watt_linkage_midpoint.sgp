sgp 2

given
  segment AC
    d1: |AC| = 3
    θ1: angle(xaxis, AC) = 80°
  segment BD
    d2: |BD| = 3
  segment CD
    d3: |CD| = 2

construct
  E = mid(C, D)

find
  x_E: x(E)
  y_E: y(E)

where
  A (-2, 0) [fixed]
  C (-1.4790554669992086, 2.9544232590366244)
  B (2, 0) [fixed]
  D (0.48762871480498254, 2.590894265638328)
  E (-0.4957133760971131, 2.772658762337476)
  d1 label (0.3, 0.3)
  θ1 label (0.3, 0.3)
  d2 label (0.3, 0.3)
  d3 label (0.3, 0.3)
  x_E label (0.3, 0.3)
  y_E label (0.3, 0.3)

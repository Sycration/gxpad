sgp 2

given
  l1 = segment AB
    d1: len(l1) = 3
  segment BC
    d2: |BC| = 2
  l2 = segment BA
    θ1: angle(l2, CB) = 70°

find
  d3: dist(A, C)

where
  A (0, 0)
  B (3, 0)
  C (3.6840402866513378, 1.8793852415718166)
  d1 label (0.3, 0.3)
  d2 label (0.3, 0.3)
  θ1 label (0.3, 0.3)
  d3 label (0.3, 0.3)

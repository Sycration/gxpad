sgp 2

given
  point A
  k1 = circle(A)

construct
  point B on k1
  point C on k1
  point D on k1
  triangle BCD
    |BC| == |CD|
    |CD| == |DB|
    d1: |BC| = 3

find
  r1: r(k1)

where
  A (-1.3817703926054432e-16, 0.024999999999999915)
  k1 r 1.7320508075688772
  B (1.732050729281054, 0.024479234247928652)
  C (-0.8655743682698124, 1.5252603150767918)
  D (-0.8664763610112418, -1.4747395493247206)
  d1 label (0.3, 0.3)
  r1 label (0.3, 0.3)

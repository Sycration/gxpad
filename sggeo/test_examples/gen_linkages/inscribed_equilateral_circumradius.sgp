sgp 2

given
  point A
  k1 = circle(A)

construct
  point B on k1
  point C on k1
  point D on k1
  triangle BCD
    |BC| == |CD|
    |CD| == |DB|
    d1: |BC| = 3

find
  r1: r(k1)

where
  A (-2.136164357369264e-16, 0.025)
  k1 r 1.7320508075688774
  B (1.732050729281054, 0.024479234247928507)
  C (-0.8655743682698124, 1.525260315076792)
  D (-0.8664763610112418, -1.4747395493247208)
  d1 label (0.3, 0.3)
  r1 label (0.3, 0.3)

sgp 2

given
  segment AC
    d1: |AC| = 5
  segment BD
    d2: |BD| = 5
  segment CD
    d3: |CD| = 2
  segment AB
    CD ∥ AB

construct
  E = mid(C, D)

find
  y_E: y(E)
  x_E: x(E)

where
  A (-2, 0) [fixed]
  C (-1.0000000000000007, 4.898979485566357)
  B (2, 0) [fixed]
  D (0.9999999999999996, 4.898979485566357)
  E (-5.551115123125783e-16, 4.898979485566357)
  d1 label (0.3, 0.3)
  d2 label (0.3, 0.3)
  d3 label (0.3, 0.3)
  y_E label (0.3, 0.3)
  x_E label (0.3, 0.3)

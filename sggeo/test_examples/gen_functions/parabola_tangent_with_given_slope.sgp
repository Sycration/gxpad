sgp 2

given
  g1 = curve(y = x^2)

construct
  point A on g1
  segment AB
    AB tan g1
    θ1: angle(xaxis, AB) = 45°

find
  x_A: x(A)
  y_A: y(A)

where
  A (0.4999999999999999, 0.24999999999999992)
  B (1.4763240894334357, 1.2263240894334357)
  θ1 label (0.3, 0.3)
  x_A label (0.3, 0.3)
  y_A label (0.3, 0.3)

sgp 2

given
  a = 0.75
  g1 = curve(y = a*x^2)

construct
  point A on g1
    x_A: x(A) = 2
  point B on xaxis
  segment AB
    AB tan g1
  point C on AB

find
  x_B: x(B)
  y_A: y(A)

where
  A (2, 3)
  B (0.9999999999999999, 4.514379789643681e-31)
  C (1.346881287726358, 1.0406438631790744)
  x_A label (0.3, 0.3)
  x_B label (0.3, 0.3)
  y_A label (0.3, 0.3)

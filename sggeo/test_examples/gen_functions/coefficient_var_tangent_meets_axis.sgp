sgp 2

given
  a = 0.75
  g1 = curve(y = a*x^2)

construct
  point A on g1
    x_A: x(A) = 2
  point B on xaxis
  segment AB
    AB tan g1
  point C on AB

find
  x_B: x(B)
  y_A: y(A)

where
  A (2, 3)
  B (0.9999999999999999, 2.5697698655398443e-27)
  C (1.3468812877263507, 1.040643863179052)
  x_A label (0.3, 0.3)
  x_B label (0.3, 0.3)
  y_A label (0.3, 0.3)

sgp 2

given
  g1 = curve(y = x^3 - 3*x)
  line OA
    θ1: angle(xaxis, OA) = 45°

construct
  B = meet(OA, g1)
  C = meet(OA, g1)

find
  d1: dist(B, C)

where
  A (1.052379156517378, 1.0523791565173777)
  B (2, 1.9999999999999996)
  C (-1.9999999999999998, -1.9999999999999993)
  θ1 label (0.3, 0.3)
  d1 label (0.3, 0.3)

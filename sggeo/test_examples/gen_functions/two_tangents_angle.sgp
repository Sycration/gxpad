sgp 2

given
  g1 = curve(y = x^2)
  point A

construct
  B = tangent(A, g1)
  segment AB
  C = tangent(A, g1)
  segment AC
  point D on AB

find
  θ1: angle(AB, CA)
  d1: dist(B, C)

where
  A (0, -1) [fixed]
  B (1, 1)
  C (-1, 1)
  D (0.30000000000000004, -0.39999999999999997)
  θ1 label (0.3, 0.3)
  d1 label (0.3, 0.3)

sgp 2

given
  g1 = curve(y = x^3 - 3*x)

construct
  point A on g1
  point C on g1
  segment AB
    horiz A B
    AB tan g1
  segment CD
    horiz C D
    CD tan g1

find
  d1: dist(A, C)
  y_A: y(A)
  x_C: x(C)

where
  A (1, -2)
  C (-1, 2)
  B (2.5, -2)
  D (-2.5, 2)
  d1 label (0.3, 0.3)
  y_A label (0.3, 0.3)
  x_C label (0.3, 0.3)

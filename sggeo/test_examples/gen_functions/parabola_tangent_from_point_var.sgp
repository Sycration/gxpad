sgp 2

given
  a = 4
  g1 = curve(y = x^2)
  point A
    x_A: x(A) = 0
    y_A: y(A) = -a

construct
  B = tangent(A, g1)
  segment AB
  point C on AB

find
  x_B: x(B)
  y_B: y(B)

where
  A (1.617269844780878e-173, -4)
  B (2, 4)
  C (0.9473976638642485, -0.21040934454300575)
  x_A label (0.3, 0.3)
  y_A label (0.3, 0.3)
  x_B label (0.3, 0.3)
  y_B label (0.3, 0.3)

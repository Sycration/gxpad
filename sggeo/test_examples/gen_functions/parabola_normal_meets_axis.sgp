sgp 2

given
  t = 2
  g1 = curve(y = x^2)

construct
  point A on g1
    x_A: x(A) = t
  segment AB
    AB tan g1
  l1 = perp(AB, A)
  C = meet(l1, yaxis)

find
  y_C: y(C)

where
  A (2, 4)
  B (1.318837029798791, 1.275348119195164)
  C (-1.8488927466117464e-32, 4.5)
  x_A label (0.3, 0.3)
  y_C label (0.3, 0.3)

sgp 2

given
  g1 = curve(y = cos(x))

construct
  point A on g1
  point C on g1
  segment AB
    horiz A B
    AB tan g1
  segment CD
    horiz C D
    CD tan g1

find
  d1: dx(A, C)
  d2: dy(A, C)

where
  A (3.141592653589793, -1)
  C (6.283185307179586, 1)
  B (4, -1)
  D (7.000000000000001, 1)
  d1 label (0.3, 0.3)
  d2 label (0.3, 0.3)

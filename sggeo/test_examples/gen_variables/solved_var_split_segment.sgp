sgp 2

given
  u ~ 4.666666666666667
  segment AB
    d1: |AB| = u
  segment BC
    AB ∥ BC
    d2: |BC| = u/2
  segment AC
    d3: |AC| = 7

find
  d4: |AB|

where
  A (-0.05555555555555664, 0)
  B (4.611111111111111, 0)
  C (6.944444444444444, 0)
  d1 label (0.3, 0.3)
  d2 label (0.3, 0.3)
  d3 label (0.3, 0.3)
  d4 label (0.3, 0.3)

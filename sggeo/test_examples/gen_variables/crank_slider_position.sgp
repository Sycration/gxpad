sgp 2

given
  th = 75
  L = 2
  R = 5
  segment OA
    d1: |OA| = L
    θ1: angle(xaxis, OA) = th°

construct
  point B on xaxis
  segment AB
    d2: |AB| = R

find
  x_B: x(B)

where
  A (0.5176380902050414, 1.9318516525781366)
  B (5.129356771177584, 1.5154017989295637e-27)
  d1 label (0.3, 0.3)
  θ1 label (0.3, 0.3)
  d2 label (0.3, 0.3)
  x_B label (0.3, 0.3)

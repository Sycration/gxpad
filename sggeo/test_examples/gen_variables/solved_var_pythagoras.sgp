sgp 2

given
  s ~ 3.9999999999999982
  segment AB
    d1: |AB| = 3
  segment AC
    AB ⟂ AC
    d2: |AC| = s
  segment BC
    d3: |BC| = s + 1

find
  θ1: angle(AB, BC)

where
  A (0.04503369232331625, -0.04202891077548937)
  B (3.044918936130841, -0.015789170192384478)
  C (0.01004737154584308, 3.9578180809678747)
  d1 label (0.3, 0.3)
  d2 label (0.3, 0.3)
  d3 label (0.3, 0.3)
  θ1 label (0.3, 0.3)

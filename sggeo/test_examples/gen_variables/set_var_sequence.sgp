sgp 2

given
  t = 1.5
  segment OA
    horiz O A
    d1: |OA| = 3
  segment OB
    d2: |OB| = t + 1
  segment AB
    d3: |AB| = t + 2

find
  θ1: ∠AOB

where
  A (3, 5.553580772755923e-28)
  B (0.5000000000000001, 2.449489742783178)
  d1 label (0.3, 0.3)
  d2 label (0.3, 0.3)
  d3 label (0.3, 0.3)
  θ1 label (0.3, 0.3)

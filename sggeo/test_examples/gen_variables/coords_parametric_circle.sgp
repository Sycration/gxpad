sgp 2

given
  th = 80
  R = 4
  segment OA
    x_A: x(A) = R*cos(th°)
    y_A: y(A) = R*sin(th°)
  segment OB
    OA ⟂ OB
    d1: |OB| = R/2

find
  x_B: x(B)
  y_B: y(B)

where
  A (0.6945927106677217, 3.939231012048832)
  B (-1.969615506024416, 0.34729635533386083)
  x_A label (0.3, 0.3)
  y_A label (0.3, 0.3)
  d1 label (0.3, 0.3)
  x_B label (0.3, 0.3)
  y_B label (0.3, 0.3)

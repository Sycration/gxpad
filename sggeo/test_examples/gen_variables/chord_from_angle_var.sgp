sgp 2

given
  r = 3
  th = 70
  point A
  k1 = circle(A)
    r1: r(k1) = sqrt(2)*r/sqrt(2)
  segment AB
    B on k1
  segment AC
    C on k1
    θ1: ∠BAC = th°

find
  d1: dist(B, C)

where
  A (0.029474330517710267, 0.008036297323341445)
  k1 r 3
  B (3.0271335281080622, 0.12652399753718752)
  C (0.9433921413742278, 2.865439705139471)
  r1 label (0.3, 0.3)
  θ1 label (0.3, 0.3)
  d1 label (0.3, 0.3)

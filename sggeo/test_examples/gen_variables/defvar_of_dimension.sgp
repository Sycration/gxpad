sgp 2

given
  segment OA
    horiz O A
    d1: |OA| = 4
  segment OB
    d2: |OB| = w
  segment AB
    d3: |AB| = w + 2

find
  θ1: ∠AOB
  w = d1*3/4

where
  A (4, -1.0916571452270926e-172)
  B (-2.5032131788152814e-16, 3)
  d1 label (0.3, 0.3)
  d2 label (0.3, 0.3)
  d3 label (0.3, 0.3)
  θ1 label (0.353553, 0.353553)

# Ptolemy: the diagonals of a cyclic quadrilateral
sgp 2

given
  point A
  k1 = circle(A)

construct
  point B on k1
  point C on k1
  point D on k1
  point E on k1
  polygon BCDE
    d1: |BC| = 2.6
    d2: |CD| = 3.1
    d3: |DE| = 2.4
    d4: |EB| = 3.3
  segment BD
  segment CE

find
  d5: |BD|
  d6: |CE|

where
  A (0.15245567385805478, -0.052095780600957396)
  k1 r 2.031778404348891
  B (2.0309835062091985, 0.7220209208469812)
  C (-0.26840462569358337, 1.935616495519465)
  D (-1.7393472651588306, -0.7931795304603101)
  E (0.28687539399972145, -2.079422794976182)
  d1 label (0.3, 0.3)
  d2 label (0.3, 0.3)
  d3 label (0.3, 0.3)
  d4 label (0.3, 0.3)
  d5 label (0.3, 0.3)
  d6 label (0.3, 0.3)

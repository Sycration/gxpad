# The tangent to e^x through the origin
sgp 2

given
  g1 = curve(y = exp(x))

construct
  A = tangent(O, g1)
  segment OA
  point B on OA

find
  x_A: x(A)
  y_A: y(A)
  d1: |OA|

where
  A (1, 2.718281828459045)
  B (0.5132394525757785, 1.3951294775850067)
  x_A label (0.3, 0.3)
  y_A label (0.3, 0.3)
  d1 label (0.3, 0.3)

gxp 2

given
  k1 = circle(O)
    r1: r(k1) = 1000

construct
  point A on k1
  segment OA
    θ1: angle(xaxis, AO) = 45°

find
  x_A: x(A)
  y_A: y(A)

where
  k1 r 1000
  A (-707.1067811865476, -707.1067811865476)
  r1 label (0.3, 0.3)
  θ1 label (0.3, 0.3)
  x_A label (0.3, 0.3)
  y_A label (0.3, 0.3)

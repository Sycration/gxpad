  A (-0.014491688217788136, 2.0332283233060795)
  B (2.0070358240543866, 0.5623692147825363)
  C (-1.9925441358365987, 0.504402461911384)
  d1 label (0.3, 0.3)
  d2 label (0.3, 0.3)
  d3 label (0.3, 0.3)

gxp 2

given
  segment OA
    horiz O A
    d1: |OA| = 2
  segment OB
    d2: |OB| = 2
    θ1: ∠AOB = 120°

find
  y_B: y(B)
  x_B: x(B)

where
  A (2, -1.5575712690663207e-40)
  B (-0.9999999999999998, 1.7320508075688774)
  d1 label (0.3, 0.3)
  d2 label (0.3, 0.3)
  θ1 label (0.3, 0.3)
  y_B label (0.3, 0.3)
  x_B label (0.3, 0.3)

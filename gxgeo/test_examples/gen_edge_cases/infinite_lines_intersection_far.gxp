gxp 2

given
  line AB
    θ1: angle(xaxis, BA) = 150°
  line CD
    θ2: angle(xaxis, CD) = 135°

construct
  E = meet(AB, CD)

find
  x_E: x(E)

where
  A (0, 0) [fixed]
  B (0.9699842850844104, 0.560020688103191)
  C (10, 0) [fixed]
  D (9, 1.0000000000000002)
  E (6.3397459621556145, 3.6602540378443864)
  θ1 label (0.3, 0.3)
  θ2 label (0.3, 0.3)
  x_E label (0.3, 0.3)

gxp 2

given
  point A
  k1 = circle(A)
    r1: r(k1) = 1000

construct
  point B on k1
    d1: dy(A, B) = 800
  point C on k1
    horiz B C
  segment BC

find
  d2: |BC|

where
  A (0, 0) [fixed]
  k1 r 1000
  B (600, 800)
  C (-600, 800)
  r1 label (0.3, 0.3)
  d1 label (0.3, 0.3)
  d2 label (0.3, 0.3)

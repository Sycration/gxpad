gxp 2

given
  triangle ABC
    d1: |AB| = 6
    d2: |BC| = 10
    d3: |CA| = 8
  point D
  k1 = circle(D)
    A on k1
    B on k1
    C on k1

find
  d4: dist(D, B)
  d5: dist(D, C)
  r1: r(k1)

where
  A (0, 0)
  B (6, 0)
  C (0, 8)
  D (3, 4)
  k1 r 5
  d1 label (0.3, 0.3)
  d2 label (0.3, 0.3)
  d3 label (0.3, 0.3)
  d4 label (0.3, 0.3)
  d5 label (0.3, 0.3)
  r1 label (0.3, 0.3)

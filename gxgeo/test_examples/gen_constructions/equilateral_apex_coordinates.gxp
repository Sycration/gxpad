gxp 2

given
  segment OA
    x_A: x(A) = 4
    y_A: y(A) = 0
  k1 = circle(O)
    r(k1) == |OA|
  k2 = circle(A)
    r(k2) == |OA|

construct
  B = meet(k1, k2)
  C = mid(O, A)
  l1 = perp(OA, C)
  D = mid(O, B)
  l2 = perp(OB, D)
  E = meet(l1, l2)

find
  x_B: x(B)
  y_B: y(B)
  y_E: y(E)

where
  A (4, -1.764585135562804e-24)
  k1 r 4
  k2 r 4
  B (1.9999999999999998, 3.464101615137755)
  C (2, -9.618350039514798e-25)
  D (0.9999999999999999, 1.7320508075688774)
  E (2, 1.1547005383792517)
  x_A label (0.3, 0.3)
  y_A label (0.3, 0.3)
  x_B label (0.3, 0.3)
  y_B label (0.3, 0.3)
  y_E label (0.3, 0.3)

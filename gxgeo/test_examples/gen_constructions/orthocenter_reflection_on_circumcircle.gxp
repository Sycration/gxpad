gxp 2

given
  triangle ABC
    d1: |AB| = 6.020797289396148
    d2: |BC| = 5.656854249492381
    d3: |CA| = 4.924428900898052

construct
  D = mid(A, B)
  l1 = perp(AB, D)
  E = mid(B, C)
  l2 = perp(BC, E)
  F = meet(l1, l2)
  l3 = perp(BC, A)
  l4 = perp(CA, B)
  G = meet(l3, l4)
  H = reflect(G, BC)
  I = reflect(G, CA)

find
  d4: dist(F, H)
  d5: dist(F, I)

where
  A (0, 0)
  B (6, 0.5)
  C (2, 4.5)
  D (3, 0.25)
  E (4, 2.5)
  F (2.9038461538461537, 1.403846153846154)
  G (2.1923076923076925, 2.192307692307692)
  H (4.3076923076923075, 4.307692307692308)
  I (0.15820777160983335, 3.0963521015067417)
  d1 label (0.3, 0.3)
  d2 label (0.3, 0.3)
  d3 label (0.3, 0.3)
  d4 label (0.3, 0.3)
  d5 label (0.3, 0.3)

gxp 2

given
  point C
    x_C: x(C) = 3
    y_C: y(C) = 0
  line OA
    θ1: angle(xaxis, OA) = 60°
  line OB
    θ2: angle(xaxis, OB) = 80°

construct
  D = reflect(C, OA)
  E = reflect(D, OB)

find
  x_E: x(E)
  y_E: y(E)
  x_D: x(D)

where
  C (3, 0)
  A (0.9861866987566675, 1.7081254679951705)
  B (0.1941473126687256, 1.101064124665778)
  D (-1.4999999999999991, 2.5980762113533165)
  E (2.2981333293569337, 1.9283628290596178)
  x_C label (0.3, 0.3)
  y_C label (0.3, 0.3)
  θ1 label (0.3, 0.3)
  θ2 label (0.3, 0.3)
  x_E label (0.3, 0.3)
  y_E label (0.3, 0.3)
  x_D label (0.3, 0.3)

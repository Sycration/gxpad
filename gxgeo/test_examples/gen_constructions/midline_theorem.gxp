gxp 2

given
  triangle ABC
    d1: |AB| = 6.020797289396148
    d2: |BC| = 5.656854249492381
    d3: |CA| = 4.924428900898052

construct
  D = mid(AB)
  l1 = par(BC, D)
  E = meet(l1, CA)

find
  d4: dist(D, E)
  d5: dist(A, E)

where
  A (0, 0)
  B (6, 0.5)
  C (2, 4.5)
  D (3, 0.25)
  E (1, 2.25)
  d1 label (0.3, 0.3)
  d2 label (0.3, 0.3)
  d3 label (0.3, 0.3)
  d4 label (0.3, 0.3)
  d5 label (0.3, 0.3)

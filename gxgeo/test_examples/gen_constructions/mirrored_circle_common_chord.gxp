gxp 2

given
  point A
    d1: dist(A, xaxis) = 1.5
  k1 = circle(A)
    r1: r(k1) = 2.5

construct
  B = reflect(A, xaxis)
  k2 = circle(B)
    r(k1) == r(k2)
  C = meet(k1, k2)
  D = meet(k1, k2)

find
  d2: dist(C, D)
  d3: dist(A, B)
  y_B: y(B)

where
  A (1, 1.5)
  k1 r 2.5
  B (1, -1.5)
  k2 r 2.5
  C (3, 0)
  D (-1, 0)
  d1 label (0.3, 0.3)
  r1 label (0.3, 0.3)
  d2 label (0.3, 0.3)
  d3 label (0.3, 0.3)
  y_B label (0.3, 0.3)

gxp 2

given
  line OA
    θ1: angle(xaxis, OA) = 120°
  point B
  k1 = circle(B)
    xaxis tan k1
    OA tan k1
    r1: r(k1) = 1.5

construct
  C = meet(xaxis, k1)

find
  d1: dist(O, C)

where
  A (-0.9861832661930405, 1.7081195226205697)
  B (0.8660254037844388, 1.5)
  k1 r 1.5
  C (0.8660254037844388, -1.661603667057795e-40)
  θ1 label (0.3, 0.3)
  r1 label (0.3, 0.3)
  d1 label (0.3, 0.3)

gxp 2

given
  point A
  k1 = circle(A)
    r1: r(k1) = 3
  point B
  k2 = circle(B)
    k1 tan k2
    r2: r(k2) = 2

find
  d1: dist(A, B)

where
  A (0.10415014581097788, 0.006008662258325646)
  k1 r 3
  B (5.095849854189022, 0.29399133774167435)
  k2 r 2
  r1 label (0.3, 0.3)
  r2 label (0.3, 0.3)
  d1 label (0.3, 0.3)

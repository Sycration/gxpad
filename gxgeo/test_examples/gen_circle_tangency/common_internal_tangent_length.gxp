gxp 2

given
  point A
  k1 = circle(A)
    r1: r(k1) = 3
  point B
    d1: dist(A, B) = 8
  k2 = circle(B)
    r2: r(k2) = 2

construct
  point C on k1
  point D on k2
  segment CD
    CD tan k1
    CD tan k2

find
  d2: |CD|

where
  A (-0.07843463216196012, -0.022953133389456364)
  k1 r 3
  B (7.920919489126912, 0.07870139045845306)
  k2 r 2
  C (1.766656226048322, 2.3425573241965685)
  D (6.690858916986723, -1.4983055812655635)
  r1 label (0.3, 0.3)
  d1 label (0.3, 0.3)
  r2 label (0.3, 0.3)
  d2 label (0.3, 0.3)

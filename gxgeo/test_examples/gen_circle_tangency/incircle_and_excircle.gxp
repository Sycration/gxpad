gxp 2

given
  triangle ABC
    d1: |AB| = 4
    d2: |CA| = 3
    d3: |BC| = 5
  point D
  k1 = circle(D)
    AB tan k1
    BC tan k1
    CA tan k1
  point E
  k2 = circle(E)
    AB tan k2
    BC tan k2
    CA tan k2

find
  r1: r(k1)
  r2: r(k2)

where
  A (0.026970685108184376, -0.01047915600634373)
  B (4.025895031160075, 0.0822789948671066)
  C (-0.042597928046903134, 2.988714103532574)
  D (1.0035122339027944, 1.0124414682249916)
  k1 r 0.9999999999999999
  E (5.886219977875847, 6.127044589381669)
  k2 r 6.000000000000003
  d1 label (0.3, 0.3)
  d2 label (0.3, 0.3)
  d3 label (0.3, 0.3)
  r1 label (0.3, 0.3)
  r2 label (0.3, 0.3)

gxp 2

given
  point A
  k1 = circle(A)
    r1: r(k1) = 4
  point B
  k2 = circle(B)
    k1 tan k2 inside
    r2: r(k2) = 2.5

find
  d1: dist(A, B)

where
  A (-0.04246212024587492, -0.0060660171779821324)
  k1 r 4
  B (1.442462120245875, 0.20606601717798215)
  k2 r 2.5
  r1 label (0.3, 0.3)
  r2 label (0.3, 0.3)
  d1 label (0.3, 0.3)

gxp 2

given
  segment OA
    d1: |OA| = 2
    θ1: angle(xaxis, OA) = 15°

construct
  point B on xaxis
  segment AB
    d2: |AB| = 3

find
  x_B: x(B)

where
  A (1.9318516525781366, 0.5176380902050414)
  B (4.886856019337833, 9.152019095728145e-29)
  d1 label (0.3, 0.3)
  θ1 label (0.99382, 0.111005)
  d2 label (0.3, 0.3)
  x_B label (0.3, 0.3)

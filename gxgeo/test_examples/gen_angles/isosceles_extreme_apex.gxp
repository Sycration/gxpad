gxp 2

given
  l1 = segment AB
    d1: len(l1) = 3
  segment AC
    len(l1) == |AC|
    θ1: angle(l1, AC) = 2°
  l2 = segment BA
  segment BC

find
  θ2: angle(l2, BC)

where
  A (0.0003602741777507282, 0.000005491874146548629)
  B (3.0002560957428006, 0.025006686976673624)
  C (2.9975561111367366, 0.12968631125668273)
  d1 label (0.3, 0.3)
  θ1 label (0.999668, 0.0257843)
  θ2 label (-0.719067, 0.694941)

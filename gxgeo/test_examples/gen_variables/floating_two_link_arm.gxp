gxp 2

given
  L = 3
  segment AB
    d1: |AB| = L
  segment BC
    d2: |BC| = 1.5*L
    θ1: angle(AB, BC) = 90°

find
  d3: dist(A, C)

where
  A (-0.6445843081899884, -0.41821363697337915)
  B (2.3553304462932334, -0.44082924737572676)
  C (2.389253861896755, 4.059042884349106)
  d1 label (0.3, 0.3)
  d2 label (0.3, 0.3)
  θ1 label (0.3, 0.3)
  d3 label (0.3, 0.3)

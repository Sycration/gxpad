gxp 2

given
  s ~ 3.999999999999996
  segment AB
    d1: |AB| = 3
  segment AC
    AB ⟂ AC
    d2: |AC| = s
  segment BC
    d3: |BC| = s + 1

find
  θ1: angle(AB, BC)

where
  A (0.0450336923181647, -0.042028910771695155)
  B (3.04491893612579, -0.01578917020010617)
  C (0.010047371556046155, 3.9578180809718013)
  d1 label (0.3, 0.3)
  d2 label (0.3, 0.3)
  d3 label (0.3, 0.3)
  θ1 label (0.3, 0.3)

gxp 2

given
  h = 2
  segment AB
    d1: |AB| = 6
  segment CA
  segment CB
    |CA| == |CB|

construct
  D = mid(A, B)
    d2: dist(C, D) = h

find
  d3: |CA|
  θ1: ∠ACB

where
  A (-2.9191368356665284, 0.6099547281356676)
  B (3.0791164374525826, 0.46518708148812576)
  C (0.1282456831088745, 2.5369886625182674)
  D (0.07998980089302712, 0.5375709048118967)
  d1 label (0.3, 0.3)
  d2 label (0.3, 0.3)
  d3 label (0.3, 0.3)
  θ1 label (0.3, 0.3)

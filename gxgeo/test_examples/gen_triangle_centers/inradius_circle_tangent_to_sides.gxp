gxp 2

given
  line OA
    horiz O A
    d1: |OA| = 14
  line AB
    d2: |AB| = 15
  line BO
    d3: |BO| = 13
  point C
  k1 = circle(C)
    OA tan k1
    AB tan k1
    BO tan k1

find
  r1: r(k1)
  x_C: x(C)

where
  A (14, -5.590127219380615e-27)
  B (4.999999999999999, 12)
  C (6, 4)
  k1 r 4
  d1 label (0.3, 0.3)
  d2 label (0.3, 0.3)
  d3 label (0.3, 0.3)
  r1 label (0.3, 0.3)
  x_C label (0.3, 0.3)

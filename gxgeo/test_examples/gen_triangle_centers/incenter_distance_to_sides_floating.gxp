gxp 2

given
  triangle BCA
    d1: |BC| = 14
    d2: |CA| = 15
    d3: |AB| = 13

construct
  l1 = bisect(BA, BC)
  l2 = bisect(CB, CA)
  D = meet(l1, l2)

find
  d4: dist(D, CA)
  d5: dist(A, D)

where
  B (-0.049921759598129584, 0.041351414250523355)
  C (13.947351248222345, -0.23496062772441653)
  A (5.185943207744846, 11.940331120248452)
  D (6.027855827174914, 3.9221528270671135)
  d1 label (0.3, 0.3)
  d2 label (0.3, 0.3)
  d3 label (0.3, 0.3)
  d4 label (0.3, 0.3)
  d5 label (0.3, 0.3)

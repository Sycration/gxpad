gxp 2

given
  segment AB
    d1: |AB| = 4
  segment AC
    AB ⟂ AC
    d2: |AC| = 3
  segment BC

construct
  D = mid(BC)

find
  d3: |BC|
  d4: dist(A, BC)
  d5: dist(A, D)

where
  A (0.05401002647493124, 0.03967575982361079)
  B (4.053177681497064, 0.12127273908617908)
  C (-0.00718770797199497, 3.0390515010902104)
  D (2.0229949867625345, 1.5801621200881948)
  d1 label (0.3, 0.3)
  d2 label (0.3, 0.3)
  d3 label (0.3, 0.3)
  d4 label (0.3, 0.3)
  d5 label (0.3, 0.3)

gxp 2

given
  segment AB
    horiz A B
    d1: |AB| = 6
  segment CA
    d2: dist(C, xaxis) = 4
  segment CB

construct
  D = mid(A, B)
  E = mid(B, C)
  segment CD
  segment AE
  F = meet(CD, AE)

find
  d3: dist(F, xaxis)

where
  A (0, 0) [fixed]
  B (6, 6.249257483547703e-29)
  C (2.0080955891638053, 4)
  D (3, 4.737479514401498e-29)
  E (4.004047794581902, 2)
  F (2.6693651963879352, 1.3333333333333335)
  d1 label (0.3, 0.3)
  d2 label (0.3, 0.3)
  d3 label (0.3, 0.3)

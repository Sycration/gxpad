gxp 2

given
  l1 = segment BC
    d1: len(l1) = 14
  segment CA
    d2: |CA| = 15
  segment AB
    d3: |AB| = 13
  point G
  k1 = circle(G)
  l3 = line BC

construct
  D = mid(B, C)
    D on k1
  E = mid(C, A)
    E on k1
  F = mid(A, B)
    F on k1
  l2 = perp(BC, A)
  H = meet(l2, l3)

find
  d4: dist(G, H)
  d5: dist(B, H)

where
  B (-0.03770485740115989, 0.032114396452882235)
  C (13.95964710505379, -0.24016861652914975)
  A (5.194734854603065, 11.932600716777827)
  G (6.037739866766445, 3.852176916043895)
  k1 r 4.0625
  D (6.960971123826315, -0.10402711003813375)
  E (9.577190979828428, 5.8462160501243385)
  F (2.578514998600953, 5.982357556615355)
  H (4.961349414904181, -0.06512953675498637)
  d1 label (0.3, 0.3)
  d2 label (0.3, 0.3)
  d3 label (0.3, 0.3)
  d4 label (0.3, 0.3)
  d5 label (0.3, 0.3)

gxp 2

given
  w ~ 2.0943951023931957
  g1 = curve(y = sin(w*x))

construct
  A = meet(g1, xaxis)
    x_A: x(A) = 3
  point B on g1
  segment BC
    horiz B C
    BC tan g1

find
  x_B: x(B)
  y_B: y(B)

where
  A (3, 5.321113324748606e-29)
  B (0.75, 1)
  C (1.5, 1)
  x_A label (0.3, 0.3)
  x_B label (0.3, 0.3)
  y_B label (0.3, 0.3)

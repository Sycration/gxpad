gxp 2

given
  h = 0.2
  g1 = curve(y = 1/(1 + x^2))
  line AB
    horiz A B
    x_A: x(A) = 0
    y_A: y(A) = h

construct
  C = meet(AB, g1)
  D = meet(AB, g1)

find
  d1: dist(C, D)

where
  A (-3.8349304041536815e-82, 0.2)
  B (2, 0.2)
  C (2, 0.2)
  D (-2, 0.2)
  x_A label (0.3, 0.3)
  y_A label (0.3, 0.3)
  d1 label (0.3, 0.3)

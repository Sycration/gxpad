gxp 2

given
  segment OA
    horiz O A
    d1: |OA| = 6
  segment OB
    OA ⟂ OB
    d2: |OB| = 8
  segment AB

construct
  l1 = perp(AB, O)
  C = meet(l1, AB)

find
  d3: dist(O, C)
  x_C: x(C)

where
  A (6, -1.2375808859435994e-36)
  B (6.025680469586012e-35, 8)
  C (3.84, 2.88)
  d1 label (0.3, 0.3)
  d2 label (0.3, 0.3)
  d3 label (0.3, 0.3)
  x_C label (0.3, 0.3)

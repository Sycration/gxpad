gxp 2

given
  k1 = circle(O)
    r1: r(k1) = 5
  k2 = circle(O)
    r2: r(k2) = 3

construct
  point A on k1
  point B on k1
  segment AB
    AB tan k2

find
  d1: |AB|

where
  k1 r 5
  k2 r 3
  A (-4, 2.9999999999999996)
  B (3.9999999999999996, 3.0000000000000004)
  r1 label (0.3, 0.3)
  r2 label (0.3, 0.3)
  d1 label (0.3, 0.3)

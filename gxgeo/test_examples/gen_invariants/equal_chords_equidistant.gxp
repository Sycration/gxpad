gxp 2

given
  k1 = circle(O)
    r1: r(k1) = 3

construct
  point A on k1
  point B on k1
  point C on k1
  point D on k1
  segment AB
    d1: |AB| = 4
  segment CD
    |AB| == |CD|

find
  d2: dist(O, CD)

where
  k1 r 3
  A (2.7576187358583026, 1.1813292968699531)
  B (-0.8676124122882972, 2.871802343832751)
  C (-2.644165531722233, -1.4171762913808854)
  D (1.1146049514214003, -2.7852568646835607)
  r1 label (0.3, 0.3)
  d1 label (0.3, 0.3)
  d2 label (0.3, 0.3)

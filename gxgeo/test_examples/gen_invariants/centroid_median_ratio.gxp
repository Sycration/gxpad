gxp 2

given
  triangle ABC
    d1: |AB| = 6
    d2: |BC| = 5
    d3: |CA| = 4

construct
  D = mid(BC)
  E = mid(CA)
  line AD
  line BE
  F = meet(AD, BE)

find
  d4: dist(A, F)
  d5: dist(F, D)

where
  A (-0.044692712535356255, 0.3806256855288688)
  B (5.949783685554066, 0.6380217087088476)
  C (2.061359714708335, 3.7812937336777845)
  D (4.005571700131201, 2.209657721193316)
  E (1.0083335010864893, 2.0809597096033268)
  F (2.655483562575682, 1.5999803759718336)
  d1 label (0.3, 0.3)
  d2 label (0.3, 0.3)
  d3 label (0.3, 0.3)
  d4 label (0.3, 0.3)
  d5 label (0.3, 0.3)

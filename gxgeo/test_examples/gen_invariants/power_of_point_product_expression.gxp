gxp 2

given
  k1 = circle(O)
    r1: r(k1) = 3
  segment FG
    d6: |FG| = d4*d5/2.5

construct
  point B on k1
  point C on k1
  segment BC
  point D on k1
  point E on k1
  segment DE
  segment AB
    A on BC
    A on DE
    d1: dist(O, A) = 1
    d2: |AB| = 2.5

find
  d3: dist(A, C)
  d4: dist(A, D)
  d5: dist(A, E)
  d7: |FG|

where
  k1 r 3
  F (5.3999999999999995, 6)
  G (8.6, 6)
  B (1.5826263268904752, 2.5485866493869036)
  C (0.2379980666489462, -2.990544585902602)
  D (-2.574612085890064, 1.5399261693954076)
  E (2.9283633823961397, -0.6516808272777727)
  A (0.9928770899424362, 0.11914312513712065)
  r1 label (0.3, 0.3)
  d6 label (0.3, 0.3)
  d1 label (0.3, 0.3)
  d2 label (0.3, 0.3)
  d3 label (0.3, 0.3)
  d4 label (0.3, 0.3)
  d5 label (0.3, 0.3)
  d7 label (0.3, 0.3)

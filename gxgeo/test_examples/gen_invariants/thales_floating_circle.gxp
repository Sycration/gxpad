gxp 2

given
  point A
  k1 = circle(A)
    r1: r(k1) = 2

construct
  point B on k1
  point C on k1
  segment BC
    A on BC
  point D on k1
  segment DB
  segment DC

find
  θ1: ∠BDC

where
  A (1, 1)
  k1 r 2
  B (-1, 1)
  C (3, 1)
  D (1.6840402866513378, 2.879385241571817)
  r1 label (0.3, 0.3)
  θ1 label (0.3, 0.3)

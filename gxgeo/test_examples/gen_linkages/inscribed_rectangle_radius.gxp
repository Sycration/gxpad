gxp 2

given
  point A
  k1 = circle(A)

construct
  point B on k1
  point C on k1
  point D on k1
  point E on k1
  segment BC
    d1: |BC| = 6
  segment CD
    BC ⟂ CD
    d2: |CD| = 8
  segment BE
    d3: |BE| = 8

find
  r1: r(k1)
  d4: dist(C, E)

where
  A (0.020000000000000146, -0.019999999999999577)
  k1 r 5
  B (-2.983999200967243, -4.016997473177605)
  C (3.0159977979796726, -4.022998525418283)
  D (3.023999200967244, 3.9769974731776054)
  E (-2.9759977979796726, 3.982998525418284)
  d1 label (0.3, 0.3)
  d2 label (0.3, 0.3)
  d3 label (0.3, 0.3)
  r1 label (0.3, 0.3)
  d4 label (0.3, 0.3)

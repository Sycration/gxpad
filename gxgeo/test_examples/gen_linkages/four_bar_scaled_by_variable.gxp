gxp 2

given
  s = 1.2
  segment OB
    d2: |OB| = s
    θ1: angle(xaxis, OB) = 75°
  segment BC
    d3: |BC| = 3s

construct
  point A on xaxis
    d1: dist(O, A) = 3s
  segment CA
    d4: |CA| = 2s

find
  y_C: y(C)

where
  B (0.3105828541230249, 1.159110991546882)
  C (3.6905881758524774, 2.3982897619753376)
  A (3.6, 4.3071298940251054e-21)
  d2 label (0.3, 0.3)
  θ1 label (0.3, 0.3)
  d3 label (0.3, 0.3)
  d1 label (0.3, 0.3)
  d4 label (0.3, 0.3)
  y_C label (0.3, 0.3)

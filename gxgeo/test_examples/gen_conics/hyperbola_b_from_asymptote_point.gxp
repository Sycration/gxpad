gxp 2

given
  h1 = hyperbola(O)
    a1: a(h1) = 3

construct
  l1 = asymptote(h1, 1)
  l2 = asymptote(h1, -1)
  point A on l1
    x_A: x(A) = 3
    y_A: y(A) = 4

find
  b1: b(h1)

where
  h1 a 3 b 4 angle 0° [fixed angle]
  A (3, 4)
  a1 label (0.3, 0.3)
  x_A label (0.3, 0.3)
  y_A label (0.3, 0.3)
  b1 label (0.3, 0.3)

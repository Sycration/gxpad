gxp 2

given
  a = 5
  b = 3
  point A
  e1 = ellipse(A)
    a1: a(e1) = a
    b1: b(e1) = b
  point C

construct
  B = focus(e1)
    A == mid(B, C)
  line BD
    vert B D
  E = meet(BD, e1)
  F = meet(BD, e1)

find
  d1: dist(E, F)

where
  A (1, 1)
  e1 a 5 b 3 angle 0° [fixed angle]
  C (-3, 1)
  B (5, 1)
  D (5, 3)
  E (5, 2.8)
  F (5, -0.8)
  a1 label (0.3, 0.3)
  b1 label (0.3, 0.3)
  d1 label (0.3, 0.3)

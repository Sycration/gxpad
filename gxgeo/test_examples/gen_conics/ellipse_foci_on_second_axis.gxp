gxp 2

given
  e1 = ellipse(O)
    a1: a(e1) = 3
    b1: b(e1) = 5
  point B

construct
  A = focus(e1)
    O == mid(A, B)

find
  d1: dist(A, B)
  x_A: x(A)

where
  e1 a 3 b 5 angle 0° [fixed angle]
  B (0, -4)
  A (0, 4)
  a1 label (0.3, 0.3)
  b1 label (0.3, 0.3)
  d1 label (0.3, 0.3)
  x_A label (0.3, 0.3)

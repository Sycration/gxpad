gxp 2

given
  e1 = ellipse(O)
    a1: a(e1) = 5
    b1: b(e1) = 3
  point B

construct
  A = focus(e1)
    O == mid(A, B)

find
  d1: dist(A, B)

where
  e1 a 5 b 3 angle 17.188733853924695°
  B (-3.821345956502424, -1.1820808266453582)
  A (3.821345956502424, 1.1820808266453582)
  a1 label (0.3, 0.3)
  b1 label (0.3, 0.3)
  d1 label (0.3, 0.3)

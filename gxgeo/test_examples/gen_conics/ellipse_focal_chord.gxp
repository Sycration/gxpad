gxp 2

given
  a = 5
  b = 3
  e1 = ellipse(O)
    a1: a(e1) = a
    b1: b(e1) = b
  point B

construct
  A = focus(e1)
    O == mid(A, B)
  line AC
    θ1: angle(xaxis, AC) = 50°
  D = meet(AC, e1)
  E = meet(AC, e1)

find
  d1: dist(D, E)

where
  e1 a 5 b 3 angle 0° [fixed angle]
  B (-4, 0)
  A (4, 0)
  C (5.2855752193730785, 1.532088886237956)
  D (4.76409635946118, 0.910614581476018)
  E (1.6181775193221828, -2.838545498269442)
  a1 label (0.3, 0.3)
  b1 label (0.3, 0.3)
  θ1 label (0.3, 0.3)
  d1 label (0.3, 0.3)

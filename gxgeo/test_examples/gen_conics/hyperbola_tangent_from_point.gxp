gxp 2

given
  h1 = hyperbola(O)
    a1: a(h1) = 2
    b1: b(h1) = 3
  point A

construct
  B = tangent(A, h1)
  segment AB

find
  d1: |AB|
  x_B: x(B)

where
  h1 a 2 b 3 angle 0° [fixed angle]
  A (1, 0) [fixed]
  B (4.000000000000002, 5.196152422706635)
  a1 label (0.3, 0.3)
  b1 label (0.3, 0.3)
  d1 label (0.3, 0.3)
  x_B label (0.3, 0.3)

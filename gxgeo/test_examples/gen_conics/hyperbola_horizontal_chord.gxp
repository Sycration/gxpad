gxp 2

given
  h = 1.5
  h1 = hyperbola(O)
    a1: a(h1) = 3
    b1: b(h1) = 2
  line AB
    horiz A B
    d1: dist(O, AB) = h

construct
  C = meet(AB, h1)
  D = meet(AB, h1)

find
  d2: dist(C, D)

where
  h1 a 3 b 2 angle 0° [fixed angle]
  A (-5, 1.5)
  B (5, 1.5)
  C (-3.75, 1.5)
  D (3.75, 1.5)
  a1 label (0.3, 0.3)
  b1 label (0.3, 0.3)
  d1 label (0.3, 0.3)
  d2 label (0.3, 0.3)

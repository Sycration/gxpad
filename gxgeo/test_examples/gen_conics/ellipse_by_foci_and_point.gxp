gxp 2

given
  point A
    d1: dist(O, A) = 8
  point B
    d2: dist(B, O) = 6
    d3: dist(B, A) = 4

construct
  C = mid(O, A)
  e1 = ellipse(C)
    O == focus(e1)
    B on e1
  l1 = directrix(e1, O)

find
  a1: a(e1)
  b1: b(e1)
  d4: dist(O, l1)

where
  A (7.952927996443933, 0.8665657986433003)
  B (4.904465725178353, 3.456329838217235)
  C (3.9764639982219663, 0.43328289932165015)
  e1 a 5 b 3 angle -173.78147824746802°
  d1 label (0.3, 0.3)
  d2 label (0.3, 0.3)
  d3 label (0.3, 0.3)
  a1 label (0.3, 0.3)
  b1 label (0.3, 0.3)
  d4 label (0.3, 0.3)

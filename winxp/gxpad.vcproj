<?xml version="1.0" encoding="Windows-1252"?>
<VisualStudioProject
	ProjectType="Visual C++"
	Version="9.00"
	Name="gxpad"
	ProjectGUID="{6B1E2C3A-7D44-4E5B-9A1F-2C8D0E6F4A11}"
	RootNamespace="gxpad"
	Keyword="Win32Proj"
	TargetFrameworkVersion="0"
	>
	<Platforms>
		<Platform
			Name="Win32"
		/>
	</Platforms>
	<ToolFiles>
	</ToolFiles>
	<Configurations>
		<Configuration
			Name="Debug|Win32"
			OutputDirectory="$(SolutionDir)$(ConfigurationName)"
			IntermediateDirectory="$(ConfigurationName)\obj"
			ConfigurationType="1"
			CharacterSet="1"
			>
			<Tool
				Name="VCCLCompilerTool"
				Optimization="0"
				AdditionalIncludeDirectories="..\gxgeo\include"
				PreprocessorDefinitions="WIN32;_DEBUG;_WINDOWS"
				MinimalRebuild="true"
				BasicRuntimeChecks="3"
				RuntimeLibrary="1"
				UsePrecompiledHeader="0"
				WarningLevel="3"
				DebugInformationFormat="4"
			/>
			<Tool
				Name="VCResourceCompilerTool"
			/>
			<Tool
				Name="VCLinkerTool"
				OutputFile="$(OutDir)\gxpad.exe"
				AdditionalLibraryDirectories="..\build\winxp\x86\lib"
				GenerateManifest="true"
				GenerateDebugInformation="true"
				SubSystem="2"
				TargetMachine="1"
			/>
			<Tool
				Name="VCManifestTool"
			/>
			<Tool
				Name="VCPostBuildEventTool"
				Description="Copying gxgeo.dll"
				CommandLine="xcopy /d /y /q &quot;$(ProjectDir)..\build\winxp\x86\lib\gxgeo.dll&quot; &quot;$(OutDir)\&quot;"
			/>
		</Configuration>
		<Configuration
			Name="Release|Win32"
			OutputDirectory="$(SolutionDir)$(ConfigurationName)"
			IntermediateDirectory="$(ConfigurationName)\obj"
			ConfigurationType="1"
			CharacterSet="1"
			WholeProgramOptimization="1"
			>
			<Tool
				Name="VCCLCompilerTool"
				Optimization="2"
				AdditionalIncludeDirectories="..\gxgeo\include"
				PreprocessorDefinitions="WIN32;NDEBUG;_WINDOWS"
				RuntimeLibrary="0"
				UsePrecompiledHeader="0"
				WarningLevel="3"
				DebugInformationFormat="3"
			/>
			<Tool
				Name="VCResourceCompilerTool"
			/>
			<Tool
				Name="VCLinkerTool"
				OutputFile="$(OutDir)\gxpad.exe"
				AdditionalLibraryDirectories="..\build\winxp\x86\lib"
				GenerateManifest="true"
				GenerateDebugInformation="true"
				SubSystem="2"
				OptimizeReferences="2"
				EnableCOMDATFolding="2"
				TargetMachine="1"
			/>
			<Tool
				Name="VCManifestTool"
			/>
			<Tool
				Name="VCPostBuildEventTool"
				Description="Copying gxgeo.dll"
				CommandLine="xcopy /d /y /q &quot;$(ProjectDir)..\build\winxp\x86\lib\gxgeo.dll&quot; &quot;$(OutDir)\&quot;"
			/>
		</Configuration>
	</Configurations>
	<References>
	</References>
